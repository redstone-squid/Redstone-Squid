# Required shared settings
# Under Compose the host is the "db" service; from the host itself use localhost.
SQUID_DATABASE_URL=postgresql://postgres:postgres@db:5432/redstone_squid
SQUID_VERIFICATION_CODE_PEPPER=replace_with_a_long_random_secret
# Credentials the db service is created with; keep them in sync with SQUID_DATABASE_URL.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=redstone_squid
# Production Compose defaults this to true; local processes may opt in explicitly.
# SQUID_STRICT_UNKNOWN_KEYS=true

# Discord bot
SQUID_DISCORD_TOKEN=your_token_here
# SQUID_DEVELOPMENT_MODE=false
# SQUID_COMMUNITY_REDSTONER_STARBOARD_AUTHOR_ID=700796664276844612
# SQUID_COMMUNITY_REDSTONER_STARBOARD_CHANNEL_ID=1332630008270684241
# SQUID_COMMUNITY_WELCOME_CHANNEL_ID=1356094722531393680
# SQUID_COMMUNITY_WELCOME_RELAY_CHANNEL_ID=433618741528625155

# HTTP API
SQUID_API_SECRET=replace_with_a_shared_server_secret
SQUID_API_KEY_PEPPER=replace_with_a_separate_long_random_secret
SQUID_API_SESSION_PEPPER=replace_with_another_long_random_secret
# Generate each value with `openssl rand -base64 32`. New writes use the active ID;
# retain old entries for at least 24 hours before removing them.
SQUID_API_IDEMPOTENCY_ACTIVE_KEY_ID=2026-08-v1
SQUID_API_IDEMPOTENCY_KEYS={"2026-08-v1":"replace_with_32_random_bytes_in_padded_base64"}
# Required for REST vote writes in the API process
# SQUID_API_BOT_TOKEN=your_token_here
# SQUID_API_PORT=8000
# SQUID_API_CORS_ORIGINS=["https://frontend.example"]
# Only trust addresses or CIDR ranges belonging to your reverse proxy.
# SQUID_API_TRUSTED_PROXY_IPS=["127.0.0.1","10.0.0.0/8"]

# API rate limiting (optional outside Compose; Compose provides its private Redis URL)
# SQUID_RATE_LIMIT_REDIS_URL=redis://redis:6379/0
# SQUID_RATE_LIMIT_WINDOW_SECONDS=300
# SQUID_RATE_LIMIT_IP_REQUESTS=600
# SQUID_RATE_LIMIT_PRINCIPAL_REQUESTS=300
# SQUID_RATE_LIMIT_WRITE_REQUESTS=60
# SQUID_RATE_LIMIT_VOTE_REQUESTS=30
# SQUID_RATE_LIMIT_SUGGEST_REQUESTS=1200
# SQUID_RATE_LIMIT_MINECRAFT_CHALLENGE_START_REQUESTS=10
# SQUID_RATE_LIMIT_MINECRAFT_CHALLENGE_EXCHANGE_REQUESTS=120
# SQUID_RATE_LIMIT_MINECRAFT_CHALLENGE_APPROVAL_REQUESTS=20
# SQUID_RATE_LIMIT_REDIS_TIMEOUT_SECONDS=0.2
# SQUID_RATE_LIMIT_REDIS_RETRY_SECONDS=5
# SQUID_RATE_LIMIT_LOCAL_MAX_KEYS=2048

# Discord OAuth2 browser sessions (optional; configure all three together)
# SQUID_OAUTH_DISCORD_CLIENT_ID=your_application_id
# SQUID_OAUTH_DISCORD_CLIENT_SECRET=your_oauth_client_secret
# SQUID_OAUTH_REDIRECT_URI=https://api.example/v1/auth/discord/callback
# SQUID_OAUTH_SESSION_TTL_HOURS=336

# Deterministic harness overrides (optional; non-default values are accepted only on explicit loopback hosts)
# SQUID_UPSTREAM_HTTP_MOJANG_PROFILE_URL=http://127.0.0.1:8101/mojang/profile
# SQUID_UPSTREAM_HTTP_DISCORD_API_URL=http://127.0.0.1:8102/discord/api
# SQUID_UPSTREAM_HTTP_DISCORD_AUTHORIZE_URL=http://127.0.0.1:8102/discord/authorize

# Minecraft device authorization (optional; configure both together)
# SQUID_MINECRAFT_AUTH_PEPPER=replace_with_at_least_32_random_bytes
# SQUID_MINECRAFT_AUTH_VERIFICATION_URI=https://frontend.example/minecraft/link
# Keep false for the first compatibility deploy. Enable only in a later deploy after every API and worker is new;
# rollback to the pre-compatibility images is unsafe until schema-two jobs are drained or exported. See README.md.
# SQUID_MINECRAFT_AUTH_SPONSOR_ATTRIBUTION_ENABLED=false

# Standalone CLI device approval. Configure both values to enable CLI sign-in.
# SQUID_CLI_AUTH_PEPPER=replace_with_at_least_32_random_bytes
# SQUID_CLI_AUTH_VERIFICATION_URI=https://frontend.example/cli/link

# Logging
# SQUID_LOG_LEVEL=INFO
# SQUID_LOG_ROOT_LEVEL=WARNING
# SQUID_LOG_DIRECTORY=logs
# SQUID_BOT_LOG_FILE=discord.log
# SQUID_API_LOG_FILE=api.log
# SQUID_API_ACCESS_LOG_FILE=access.log

# Observability (optional; install the `observability` extra before enabling)
# SQUID_OBSERVABILITY_ENABLED=false
# Generic OTLP/HTTP base URL; the application appends /v1/traces.
# SQUID_OBSERVABILITY_ENDPOINT=http://localhost:4318
# SQUID_OBSERVABILITY_HEADERS={"Authorization":"Bearer replace-me"}
# SQUID_OBSERVABILITY_SAMPLE_RATIO=1.0
# SQUID_OBSERVABILITY_SERVICE_NAME=redstone-squid
# Start the bundled validation Collector with: docker compose --profile observability up

# Private submission media normalization (optional and disabled by default)
# Enable this in every API and worker process so uploads and normalization agree on queue availability.
# SQUID_MEDIA_ENABLED=true
# The Compose worker image installs these pinned tools at absolute paths.
# SQUID_MEDIA_FFMPEG=/usr/bin/ffmpeg
# SQUID_MEDIA_FFPROBE=/usr/bin/ffprobe
# Must be private, writable by UID 10001, and have at least 1.5 GiB free per concurrent media job.
# SQUID_MEDIA_WORKING_DIRECTORY=/var/lib/app/media-tmp
# Keep concurrency at one unless the container has another ~3 GiB RAM and 1.5 GiB scratch space per job.
# SQUID_WORKER_MEDIA_JOB_CONCURRENCY=1
# Raw and normalized object cleanup stays enabled even when normalization is disabled.
# SQUID_WORKER_MEDIA_CLEANUP_INTERVAL_SECONDS=60
# Child-process backstops; wall-clock timeouts remain independent of the CPU limit.
# SQUID_MEDIA_MEMORY_BYTES=2147483648
# SQUID_MEDIA_CPU_SECONDS=540
# SQUID_MEDIA_MAX_OPEN_FILES=128
# SQUID_MEDIA_THREADS=2
# SQUID_MEDIA_PROBE_TIMEOUT_SECONDS=15
# SQUID_MEDIA_IMAGE_TIMEOUT_SECONDS=120
# SQUID_MEDIA_VIDEO_TIMEOUT_SECONDS=600
# SQUID_MEDIA_POSTER_TIMEOUT_SECONDS=120
# SQUID_MEDIA_JOB_MAX_ATTEMPTS=3

# OpenAI-compatible text generation (optional)
# SQUID_OPENAI_API_KEY=your_key_here
# SQUID_OPENAI_BASE_URL=https://api.openai.com/v1
# SQUID_OPENAI_CHAT_MODEL=gpt-5.6-luna
# SQUID_OPENAI_REASONING_EFFORT=low

# Embeddings (optional; falls back to the OpenAI settings above)
# SQUID_EMBEDDING_API_KEY=your_embedding_key_here
# SQUID_EMBEDDING_BASE_URL=https://api.openai.com/v1
# SQUID_EMBEDDING_MODEL=text-embedding-3-small

# Worker-owned schematic previews (optional; configure all required values together)
# SQUID_SCHEMATIC_RENDER_ENABLED=true
# SQUID_SCHEMATIC_RENDER_PACK_PATH=/run/secrets/minecraft-resource-pack.zip
# SQUID_SCHEMATIC_RENDER_PUBLIC_BASE_URL=https://api.example
# Remote packs additionally require SQUID_SCHEMATIC_RENDER_PACK_SHA256.

# Catbox account association (optional; uploads work anonymously when omitted)
# SQUID_CATBOX_USER_HASH=your_hash_here

# Google service account (optional; configure exactly one source)
# SQUID_GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# SQUID_GOOGLE_CREDENTIALS_FILE=google/client_secret.json
