# Required shared settings
SQUID_DATABASE_URL=postgresql://postgres:postgres@host:5432/mydb
SQUID_VERIFICATION_CODE_PEPPER=replace_with_a_long_random_secret

# Discord bot
SQUID_DISCORD_TOKEN=your_token_here
# SQUID_DEVELOPMENT_MODE=false

# HTTP API
SQUID_API_SECRET=replace_with_a_shared_server_secret
# SQUID_API_PORT=8000

# Logging
# SQUID_LOG_LEVEL=INFO
# SQUID_ROOT_LOG_LEVEL=WARNING
# SQUID_LOG_DIRECTORY=logs
# SQUID_BOT_LOG_FILE=discord.log
# SQUID_API_LOG_FILE=api.log
# SQUID_API_ACCESS_LOG_FILE=access.log

# OpenAI-compatible text generation (optional)
# SQUID_OPENAI_API_KEY=your_key_here
# SQUID_OPENAI_BASE_URL=https://api.openai.com/v1

# Embeddings (optional; falls back to the OpenAI settings above)
# SQUID_EMBEDDING_API_KEY=your_embedding_key_here
# SQUID_EMBEDDING_BASE_URL=https://api.openai.com/v1
# SQUID_EMBEDDING_MODEL=text-embedding-3-small
# SQUID_VECTOR_DATABASE_URL=postgresql://postgres:postgres@host:5432/mydb

# Catbox account association (optional; uploads work anonymously when omitted)
# SQUID_CATBOX_USER_HASH=your_hash_here

# Google service account (optional; configure exactly one source)
# SQUID_GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# SQUID_GOOGLE_CREDENTIALS_FILE=google/client_secret.json
