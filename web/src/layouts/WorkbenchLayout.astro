---
import { translate, type StaticMessageKey } from "../lib/i18n";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/noto-sans-sc/400.css";
import "@fontsource/noto-sans-sc/600.css";
import "../ui/base.css";
import "./workbench-layout.css";
type Props = {
  title: string;
  locale: "en" | "zh-CN";
  theme: "light" | "dark";
  framework?: "react" | "svelte";
};
const { title, locale, theme, framework = "svelte" } = Astro.props;
const query = new URLSearchParams({ lang: locale, framework, theme });
const library =
  Astro.url.pathname.replace(/\/$/, "") === "/design-system" ? "" : `/design-system?${query}`;
const t = (key: StaticMessageKey): string => translate(locale, key);
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Redstone Squid</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="sq-skip" href="#main">
      {t("workbench.skip-to-content")}
    </a>
    <header class="sq-topbar">
      <a class="sq-brand" href="/">
        <img src="/favicon.svg" width="32" height="32" alt="" />
        Redstone Squid
      </a>
      <span class="sq-muted">{t("workbench.workbench")}</span>
    </header>
    <div class="sq-shell">
      <aside class="sq-sidebar">
        <p class="sq-kicker">{t("workbench.workbench")}</p>
        <nav aria-label={t("workbench.workbench")}>
          <a href={`${library}#foundations`}>{t("workbench.foundations")}</a>
          <a href={`${library}#components`}>{t("workbench.components")}</a>
          <a href={`${library}#patterns`}>{t("workbench.page-patterns")}</a>
          <a href={`${library}#states`}>{t("workbench.feedback-states")}</a>
          <a href={`/design-system-trial?${query}`}>{t("trial.title")}</a>
        </nav>
        <p class="sq-sidebar-note">
          Astro + {framework === "svelte" ? "Svelte" : "React"}
          <br />
          {framework === "svelte" ? "Bits UI" : "Radix primitives"}
        </p>
      </aside>
      <main id="main" class="sq-main">
        <slot />
      </main>
    </div>
  </body>
</html>
