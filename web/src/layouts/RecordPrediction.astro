---
import type { RecordPreview } from "@/generated/types.gen";
import CatalogueLayout from "@/layouts/CatalogueLayout.astro";
import { formatDateTime } from "@/locales/format";
import { getLocale, localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import PageHeader from "@/ui/patterns/PageHeader.svelte";
import Section from "@/ui/patterns/Section.svelte";
import Link from "@/ui/content/Link.svelte";
interface Props {
  preview: RecordPreview;
}
const { preview } = Astro.props;
const outcomes = {
  holds: m.predictionHolds,
  shares: m.predictionShares,
  ties_later: m.predictionTies,
  loses: m.predictionLoses,
  undecided: m.predictionUndecided,
};
const title = m.predictionTitle();
---

<CatalogueLayout {title} noindex>
  <PageHeader {title} description={m.predictionExplanation()} />
  {preview.revision !== null && (
    <p>{m.submissionReviewedVersion({ revision: preview.revision })}</p>
  )}
  <time datetime={preview.evaluated_at}>
    {formatDateTime(getLocale(), preview.evaluated_at, { dateStyle: "medium", timeStyle: "short" })}
  </time>
  {preview.missing_fields.length > 0 && (
    <p>
      {m.predictionMissing()} {preview.missing_fields.join(", ")}
    </p>
  )}
  {preview.records.length === 0 && !preview.missing_fields.length && (
    <p>{m.predictionNoCategories()}</p>
  )}
  {preview.records.map((row) => (
    <Section title={row.title}>
      <p>
        {outcomes[row.outcome]()} ·{" "}
        {row.scope === "all_time" ? m.predictionAllTime() : m.predictionCurrent()}
      </p>
      {row.missing.map((gap) => (
        <p>
          {m.predictionMissing()} {gap.fields.map((field) => field.replaceAll("_", " ")).join(", ")}{" "}
          {gap.build_id && m.submissionBuildNumber({ id: gap.build_id })}
        </p>
      ))}
      {row.current_holders.length > 0 && (
        <ul>
          {row.current_holders.map((holder) => (
            <li>
              {m.predictionCurrentHolder()}{" "}
              <Link href={localizePath(`/builds/${holder.build_id}`)}>
                {holder.title ?? m.submissionBuildNumber({ id: holder.build_id })}
              </Link>
              {holder.deltas.length > 0 && (
                <ul>
                  {holder.deltas.map((delta) => (
                    <li>
                      {delta.metric.replaceAll("_", " ")} · {delta.holder} → {delta.candidate} (
                      {delta.difference > 0 ? "+" : ""}
                      {delta.difference} {delta.unit})
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      )}
    </Section>
  ))}
</CatalogueLayout>
