---
import Monitor from "@lucide/svelte/icons/monitor";
import Moon from "@lucide/svelte/icons/moon";
import Sun from "@lucide/svelte/icons/sun";
import * as m from "@/locales/messages.gen";
import SegmentedControl from "@/ui/navigation/SegmentedControl.svelte";

/**
 * The footer's theme and contrast choices. Each option is a submit button, so without
 * JavaScript the form posts to /appearance, which saves the cookie and redirects back. With
 * JavaScript the page switches in place and the post only saves the choice.
 */
const { theme, contrast, requestedPath } = Astro.locals;
const groups = [
  {
    name: "theme",
    label: m.footerTheme(),
    current: theme ?? "system",
    options: [
      { value: "system", icon: Monitor, label: m.footerSystem() },
      { value: "light", icon: Sun, label: m.footerThemeLight() },
      { value: "dark", icon: Moon, label: m.footerThemeDark() },
    ],
  },
  {
    name: "contrast",
    label: m.footerContrast(),
    current: contrast ?? "system",
    options: [
      { value: "system", icon: Monitor, label: m.footerSystem() },
      { value: "more", label: m.footerContrastMore() },
      { value: "standard", label: m.footerContrastStandard() },
    ],
  },
];
---

<form class="grid w-fit gap-2 text-sm" method="post" action="/appearance" data-appearance-switch>
  <input type="hidden" name="return" value={requestedPath} />
  {groups.map(({ name, label, current, options }) => (
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="text-fg-muted" aria-hidden="true">
        {label}
      </span>
      <SegmentedControl mode="submit" {label} {name} value={current} items={options} />
    </div>
  ))}
</form>

<script src="./appearance-switch.ts"></script>
