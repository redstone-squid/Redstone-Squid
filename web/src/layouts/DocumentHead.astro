---
import { DEFAULT_LOCALE, LOCALES, PUBLIC_LOCALES, localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import { THEME_COLORS } from "@/ui/themes";
type Props = {
  title: string;
  description?: string;
  /** Path without a locale prefix; defaults to the current route. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Share image, ideally 1200×630. A site-relative `src` is resolved against the site URL. */
  image?: { src: string; alt: string };
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const { locale, config } = Astro.locals;
const title = `${Astro.props.title} · ${m.siteName()}`;
const description = Astro.props.description ?? m.metaDefaultDescription();
const canonicalPath = Astro.props.canonicalPath ?? Astro.url.pathname;
const canonical = new URL(localizePath(canonicalPath), config.siteUrl).href;
const defaultUrl = new URL(localizePath(canonicalPath, DEFAULT_LOCALE), config.siteUrl).href;
// The pseudo-locale exists for development and review only.
const noindex = Astro.props.noindex === true || LOCALES[locale].pseudo;
const image = Astro.props.image && {
  src: new URL(Astro.props.image.src, config.siteUrl).href,
  alt: Astro.props.image.alt,
};
// Escape HTML script delimiters without changing the parsed JSON-LD value.
const jsonLd = Astro.props.structuredData
  ? JSON.stringify(Astro.props.structuredData).replaceAll("<", "\\u003c")
  : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="description" content={description} />
<meta name="theme-color" content={THEME_COLORS.light} />
<meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
<link rel="canonical" href={canonical} />
{PUBLIC_LOCALES.map((language) => (
  <link
    rel="alternate"
    hreflang={language}
    href={new URL(localizePath(canonicalPath, language), config.siteUrl).href}
  />
))}
<link rel="alternate" hreflang="x-default" href={defaultUrl} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={m.siteName()} />
<meta property="og:locale" content={LOCALES[locale].openGraph} />
{PUBLIC_LOCALES.filter((language) => language !== locale).map((language) => (
  <meta property="og:locale:alternate" content={LOCALES[language].openGraph} />
))}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{image && <meta property="og:image" content={image.src} />}
{image && <meta property="og:image:alt" content={image.alt} />}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
{image && <meta name="twitter:image" content={image.src} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<title>{title}</title>
{/* eslint-disable-next-line astro/no-set-html-directive -- jsonLd is escaped above. */}
{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
<script src="./register-service-worker.ts"></script>
<script src="./browser-telemetry.ts"></script>
<script src="../ui/image-fallback.ts"></script>
