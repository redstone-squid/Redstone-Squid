---
import { LOCALES, PUBLIC_LOCALES, localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
type Props = { align?: "start" | "end" };
const { align = "end" } = Astro.props;
const { locale } = Astro.locals;
const path = `${Astro.url.pathname}${Astro.url.search}`;
---

<details class="language-selector" data-align={align}>
  <summary aria-label={`${LOCALES[locale].label} · ${m.navLanguage()}`}>
    <span lang={locale}>{LOCALES[locale].label}</span>
    <span aria-hidden="true">⌄</span>
  </summary>
  <ul aria-label={m.navLanguage()}>
    {PUBLIC_LOCALES.map((language) => (
      <li>
        <a
          href={localizePath(path, language)}
          lang={language}
          hreflang={language}
          aria-current={language === locale ? "true" : undefined}
        >
          {LOCALES[language].label}
          <span aria-hidden="true">{language === locale ? "✓" : ""}</span>
        </a>
      </li>
    ))}
  </ul>
</details>
<style>
  .language-selector {
    position: relative;
    color: var(--text);
    font-size: 0.875rem;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    cursor: pointer;
    list-style: none;
    font-family: inherit;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  ul {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 20;
    min-width: 11rem;
    max-width: calc(100vw - 2rem);
    max-height: 60vh;
    overflow: auto;
    margin: 0.375rem 0 0;
    padding: 0.25rem;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .language-selector[data-align="start"] ul {
    left: 0;
    right: auto;
  }
  .language-selector ul a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.75rem;
    text-decoration: none;
    color: inherit;
    border-radius: 0.25rem;
  }
  .language-selector a:hover,
  .language-selector a[aria-current] {
    background: var(--surface-muted);
  }
</style>
