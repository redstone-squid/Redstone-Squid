---
import type { ComponentProps } from "astro/types";
import LanguageSelector from "./LanguageSelector.astro";
import DocumentHead from "./DocumentHead.astro";
import { localizePath, unprefixedPath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/noto-sans-sc/400.css";
import "@fontsource/noto-sans-sc/600.css";
import "@/ui/base.css";
import "./catalogue-layout.css";
type Props = ComponentProps<typeof DocumentHead>;
const { locale, config } = Astro.locals;
const activePath = unprefixedPath(Astro.url.pathname);
const nav = [
  [m.navBuilds, "/builds"],
  [m.navRecords, "/records"],
  [m.navSearch, "/search"],
  [m.navAbout, "/about"],
] as const;
---

<!doctype html>
<html lang={locale}>
  <head>
    <DocumentHead {...Astro.props} themeColor="#f5f5f4" />
  </head>
  <body>
    <a class="catalogue-skip" href="#main-content">
      {m.navSkip()}
    </a>
    <header class="catalogue-header">
      <div class="catalogue-container catalogue-nav">
        <a class="catalogue-brand" href={localizePath("/")} aria-label={m.navHome()}>
          <span class="catalogue-mark" aria-hidden="true">
            R
          </span>
          <span>{m.siteName()}</span>
        </a>
        <nav aria-label={m.navPrimary()}>
          {nav.map(([label, href]) => (
            <a
              href={localizePath(href)}
              aria-current={
                activePath === href || activePath.startsWith(`${href}/`) ? "page" : undefined
              }
            >
              {label()}
            </a>
          ))}
        </nav>
        <div class="catalogue-actions">
          <LanguageSelector align="start" />
          <a class="sq-button sq-button--primary" href={localizePath("/submit")}>
            {m.navSubmit()} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="catalogue-footer catalogue-container">
      <div>
        <a class="catalogue-brand" href={localizePath("/")}>
          <span class="catalogue-mark" aria-hidden="true">
            R
          </span>
          {m.siteName()}
        </a>
        <p class="sq-muted">{m.footerNote()}</p>
      </div>
      <nav aria-label={m.navCommunity()}>
        <a href={config.discordCommunityUrl} rel="noreferrer">
          {m.footerDiscord()}
        </a>
        <a href={config.botInviteUrl} rel="noreferrer">
          {m.footerInvite()}
        </a>
      </nav>
    </footer>
  </body>
</html>
