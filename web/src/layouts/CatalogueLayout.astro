---
import faviconUrl from "@/ui/favicon.svg?url&no-inline";
import ArrowUpRight from "@lucide/svelte/icons/arrow-up-right";
import type { ComponentProps } from "astro/types";
import AccountMenu from "./AccountMenu.astro";
import LanguageSelector from "./LanguageSelector.astro";
import DocumentHead from "./DocumentHead.astro";
import AppearanceSwitch from "./AppearanceSwitch.astro";
import { localizePath, unprefixedPath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import "@/ui/app.css";
import Button from "@/ui/actions/Button.svelte";
import SkipLink from "@/ui/content/SkipLink.svelte";
import Announcer from "@/ui/feedback/Announcer.svelte";
import Notice from "@/ui/feedback/Notice.svelte";
import Container from "@/ui/layout/Container.svelte";
import NavBar from "@/ui/patterns/NavBar.svelte";
type Props = ComponentProps<typeof DocumentHead>;
const { config, session, requestedPath } = Astro.locals;
const activePath = unprefixedPath(Astro.url.pathname);
// A new notice version leaves signed-in visitors read-only until they accept it.
const consentPending =
  session?.user != null && session.consent_pending && activePath !== "/consent";
const nav = [
  [m.navBuilds, "/builds"],
  [m.navRecords, "/records"],
  [m.navSearch, "/search"],
  [m.navAbout, "/about"],
] as const;
---

<!doctype html>
<html
  lang={Astro.locals.locale}
  data-theme={Astro.locals.theme}
  data-contrast={Astro.locals.contrast}
>
  <head>
    <DocumentHead {...Astro.props} />
  </head>
  <body>
    <SkipLink href="#main-content" label={m.navSkip()} />
    <header class="border-b border-line bg-surface">
      <Container>
        <NavBar
          label={m.navPrimary()}
          menuLabel={m.navMenu()}
          home={{ label: m.siteName(), href: localizePath("/"), logo: faviconUrl }}
          links={nav.map(([label, href]) => ({
            label: label(),
            href: localizePath(href),
            current: activePath === href || activePath.startsWith(`${href}/`),
          }))}
        >
          <Fragment slot="actions">
            <LanguageSelector />
            <Button variant="primary" href={localizePath("/submit")} iconEnd={ArrowUpRight}>
              {m.navSubmit()}
            </Button>
            <AccountMenu />
          </Fragment>
        </NavBar>
      </Container>
      {consentPending && (
        <Notice variant="banner" tone="warning">
          {m.consentPendingBanner()}
          <Fragment slot="actions">
            <a
              href={`${localizePath("/consent")}?redirect_to=${encodeURIComponent(requestedPath)}`}
            >
              {m.navReviewConsent()}
            </a>
          </Fragment>
        </Notice>
      )}
    </header>
    <Container as="main" id="main-content" class="grid content-start gap-8 py-12">
      <slot />
    </Container>
    <footer class="border-t border-line print:hidden">
      <Container class="flex justify-between gap-8 py-12 max-sm:flex-col">
        <div>
          <a
            class="inline-flex items-center gap-3 rounded-sm font-bold whitespace-nowrap no-underline"
            href={localizePath("/")}
          >
            {/* eslint-disable-next-line squid/no-raw-elements -- a bundled decorative logo needs no loading frame or fallback */}
            <img class="size-8" src={faviconUrl} width="32" height="32" alt="" />
            {m.siteName()}
          </a>
          <p class="mt-4 max-w-prose text-sm text-fg-muted">{m.footerNote()}</p>
          <div class="mt-6">
            <AppearanceSwitch />
          </div>
        </div>
        <nav aria-label={m.navCommunity()} class="flex flex-wrap items-start gap-6">
          <a href={config.discordCommunityUrl} rel="noreferrer">
            {m.footerDiscord()}
          </a>
          <a href={config.botInviteUrl} rel="noreferrer">
            {m.footerInvite()}
          </a>
        </nav>
      </Container>
    </footer>
    <Announcer />
  </body>
</html>
