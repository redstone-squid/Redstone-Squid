---
import LanguageSelector from "../components/LanguageSelector.astro";
import DocumentHead from "./DocumentHead.astro";
import Brand from "../components/Brand.astro";
import { getRuntimeConfig } from "../lib/config";
import { localeFromPath, localizePath, translate, type Locale } from "../lib/i18n";
import "../styles/global.css";

type Props = {
  title: string;
  description?: string;
  locale?: Locale;
  canonicalPath?: string;
  noindex?: boolean;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
};

const config = getRuntimeConfig();
const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const activePath = localizePath(Astro.url.pathname, "en");
const navItems = [
  ["nav.home", "/"],
  ["nav.builds", "/builds"],
  ["nav.records", "/records"],
  ["nav.search", "/search"],
  ["nav.submit", "/submit"],
  ["nav.about", "/about"],
] as const;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <DocumentHead {...Astro.props} {locale} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {translate(locale, "nav.skip")}
    </a>
    <header class="site-header">
      <div class="nav-shell">
        <a
          class="brand"
          href={localizePath("/", locale)}
          aria-label={translate(locale, "nav.home")}
        >
          <Brand locale={locale} />
        </a>
        <nav class="main-nav" aria-label="Primary">
          {navItems.map(([key, href]) => (
            <a
              href={localizePath(href, locale)}
              aria-current={
                activePath === href || (href !== "/" && activePath.startsWith(`${href}/`))
                  ? "page"
                  : undefined
              }
            >
              {translate(locale, key)}
            </a>
          ))}
        </nav>
        <LanguageSelector {locale} />
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-shell">
        <div>
          <a class="brand" href={localizePath("/", locale)}>
            <Brand locale={locale} />
          </a>
          <p>{translate(locale, "footer.note")}</p>
        </div>
        <div class="footer-links">
          <a href={config.discordCommunityUrl} rel="noreferrer">
            {translate(locale, "footer.discord")}
          </a>
          <a href={config.botInviteUrl} rel="noreferrer">
            {translate(locale, "footer.invite")}
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
