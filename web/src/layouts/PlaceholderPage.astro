---
import CatalogueLayout from "./CatalogueLayout.astro";
import { localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import Button from "@/ui/actions/Button.svelte";
import PageHeader from "@/ui/patterns/PageHeader.svelte";

/**
 * A page that is only a message. Error pages pass `status` for the matching copy; the route
 * itself sets the response status. Other pages default to the "being rebuilt" description.
 * Every placeholder links home, except home, which links to the records that already exist.
 */
type Props = { title: () => string; description?: () => string; home?: true } | { status: number };

const props = Astro.props;
const home = "home" in props && props.home === true;
const errors: Partial<Record<number, { title?: () => string; description: () => string }>> = {
  401: { description: m.errorSignedOut },
  403: { description: m.errorForbidden },
  404: { title: m.errorNotFoundTitle, description: m.errorNotFoundBody },
  429: { description: m.errorRateLimited },
  503: { title: m.errorServiceTitle, description: m.errorUnavailable },
};
const title =
  "status" in props ? (errors[props.status]?.title?.() ?? String(props.status)) : props.title();
const description =
  "status" in props
    ? (errors[props.status]?.description ?? m.errorGeneric)()
    : (props.description ?? m.placeholderRebuilding)();
---

<CatalogueLayout {title} {description} noindex={!home}>
  <PageHeader {title} {description}>
    <Fragment slot="actions">
      {home ? (
        <Button variant="primary" href={localizePath("/records")}>
          {m.navRecords()}
        </Button>
      ) : (
        <Button href={localizePath("/")}>{m.commonHome()}</Button>
      )}
    </Fragment>
  </PageHeader>
</CatalogueLayout>
