---
import CatalogueLayout from "./CatalogueLayout.astro";
import { localizePath, type Locale } from "../locales/locale";
import * as m from "../locales/messages";
import Layout from "../ui/astro/Layout.astro";
import LinkButton from "../ui/astro/LinkButton.astro";

/** Error pages pass `status` for the matching copy; the route itself sets the response status. */
type Props = { title: (locale: Locale) => string; home?: true } | { status: 404 | 503 };

const props = Astro.props;
const { locale } = Astro.locals;
const status = "status" in props ? props.status : undefined;
const home = "home" in props && props.home;
const copy =
  status === 404
    ? { title: m.errorNotFoundTitle, description: m.errorNotFoundBody }
    : status === 503
      ? { title: m.errorServiceTitle, description: m.errorServiceBody }
      : {
          title: "title" in props ? props.title : m.homeTitle,
          description: m.placeholderRebuilding,
        };
const title = copy.title(locale);
const description = copy.description(locale);
---

<CatalogueLayout {title} {description} noindex={!home}>
  <Layout pattern="stack" gap="normal" class="catalogue-container placeholder">
    <h1>{title}</h1>
    <p>{description}</p>
    <div>
      {status ? (
        <LinkButton href={localizePath("/", locale)}>{m.commonHome(locale)}</LinkButton>
      ) : (
        <LinkButton href={`/design-system?lang=${locale}`}>
          {m.workbenchPageTitle(locale)}
        </LinkButton>
      )}
    </div>
  </Layout>
</CatalogueLayout>

<style>
  .placeholder {
    padding-block: var(--space-8);
  }
</style>
