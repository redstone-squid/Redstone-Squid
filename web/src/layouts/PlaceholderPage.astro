---
import CatalogueLayout from "./CatalogueLayout.astro";
import { localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import Layout from "@/ui/astro/Layout.astro";
import LinkButton from "@/ui/astro/LinkButton.astro";

/**
 * A page that is only a message. Error pages pass `status` for the matching copy; the route
 * itself sets the response status. Other pages default to the "being rebuilt" description and a
 * link to the workbench.
 */
type Props =
  | { title: () => string; description?: () => string; home?: true; link?: "home" | "workbench" }
  | { status: 404 | 503 };

const props = Astro.props;
const status = "status" in props ? props.status : undefined;
const home = "home" in props && props.home;
const copy =
  status === 404
    ? { title: m.errorNotFoundTitle, description: m.errorNotFoundBody }
    : status === 503
      ? { title: m.errorServiceTitle, description: m.errorServiceBody }
      : {
          title: "title" in props ? props.title : m.homeTitle,
          description: ("description" in props && props.description) || m.placeholderRebuilding,
        };
const linkHome = status !== undefined || ("link" in props && props.link === "home");
const title = copy.title();
const description = copy.description();
---

<CatalogueLayout {title} {description} noindex={!home}>
  <Layout pattern="stack" gap="normal">
    <h1>{title}</h1>
    <p>{description}</p>
    <div>
      {linkHome ? (
        <LinkButton href={localizePath("/")}>{m.commonHome()}</LinkButton>
      ) : (
        <LinkButton href={localizePath("/design-system")}>{m.workbenchPageTitle()}</LinkButton>
      )}
    </div>
  </Layout>
</CatalogueLayout>
