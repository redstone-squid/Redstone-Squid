---
import Search from "@lucide/svelte/icons/search";
import { localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import Button from "@/ui/actions/Button.svelte";
import SearchBox from "@/ui/patterns/SearchBox.svelte";

type Props = { value: string };
---

<div data-header-search>
  <Button
    icon={Search}
    iconOnly
    label={m.navSearch()}
    class="@6xl:hidden"
    popovertarget="header-search-field"
  />
  <div
    id="header-search-field"
    popover="auto"
    class="fixed inset-x-0 top-20 bottom-auto m-0 w-full border border-line bg-surface p-gutter @6xl:popover-inline @6xl:block"
  >
    <div class="relative @6xl:w-64">
      <SearchBox
        compact
        action={localizePath("/search")}
        value={Astro.props.value}
        label={m.searchTitle()}
        placeholder={m.searchTitle()}
        clearLabel={m.navClearSearch()}
        submitLabel={m.navSearch()}
      />
      <kbd
        hidden
        aria-hidden="true"
        class="pointer-events-none absolute end-3 top-1/2 -translate-y-1/2 rounded-xs border border-line px-1 text-xs text-fg-muted @max-6xl:hidden"
      ></kbd>
    </div>
  </div>
</div>
<script src="./header-search.ts"></script>
