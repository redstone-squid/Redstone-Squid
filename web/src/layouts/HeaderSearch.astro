---
import Search from "@lucide/svelte/icons/search";
import { localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import Button from "@/ui/actions/Button.svelte";
import SearchBox from "@/ui/patterns/SearchBox.svelte";

type Props = { value: string };
---

<div data-header-search>
  <Button
    icon={Search}
    iconOnly
    label={m.navSearch()}
    class="@6xl:hidden"
    popovertarget="header-search-field"
  />
  <div
    id="header-search-field"
    popover="auto"
    class="fixed inset-x-0 top-20 bottom-auto m-0 w-full border border-line bg-surface p-gutter @6xl:popover-inline @6xl:block"
  >
    <div class="relative @6xl:w-64">
      <SearchBox
        compact
        action={localizePath("/search")}
        value={Astro.props.value}
        label={m.searchTitle()}
        placeholder={m.searchTitle()}
        clearLabel={m.navClearSearch()}
        submitLabel={m.navSearch()}
        class="@6xl:[&_input]:pe-14"
      />
      <kbd
        hidden
        aria-hidden="true"
        class="pointer-events-none absolute end-3 top-1/2 -translate-y-1/2 rounded-xs border border-line px-1 text-xs text-fg-muted @max-6xl:hidden"
      ></kbd>
    </div>
  </div>
</div>
<script>
  const root = document.querySelector("[data-header-search]");
  const panel = root?.querySelector<HTMLElement>("[popover]");
  const input = panel?.querySelector("input[type=search]");
  const trigger = root?.querySelector("button");
  const hint = panel?.querySelector("kbd");
  if (panel && input instanceof HTMLInputElement && trigger && hint) {
    const mac = /Mac|iPhone|iPad/.test(navigator.platform);
    hint.textContent = mac ? "⌘ K" : "Ctrl K";
    hint.hidden = false;
    panel.addEventListener("toggle", () => {
      if (panel.matches(":popover-open")) input.focus();
    });
    document.addEventListener("keydown", (event) => {
      if (
        event.defaultPrevented ||
        event.isComposing ||
        event.key.toLowerCase() !== "k" ||
        !(mac ? event.metaKey && !event.ctrlKey : event.ctrlKey && !event.metaKey) ||
        event.shiftKey ||
        event.altKey ||
        (event.target instanceof HTMLElement &&
          event.target !== input &&
          (event.target.isContentEditable ||
            event.target.closest("input, textarea, select, [role=textbox]")))
      )
        return;
      event.preventDefault();
      if (trigger.getClientRects().length && !panel.matches(":popover-open")) panel.showPopover();
      input.focus();
      input.select();
    });
  }
</script>
