---
import RuntimeSettings from "../components/RuntimeSettings";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getRuntimeConfig } from "../lib/config";
import { translate, localizePath, type Locale } from "../lib/i18n";

type Props = { locale: Locale };
const { locale } = Astro.props;
const title = translate(locale, "settings.global-settings");
---

<BaseLayout
  title={title}
  description={title}
  locale={locale}
  canonicalPath={localizePath("/admin/settings", locale)}
  noindex
>
  <section class="page-shell">
    <header class="page-heading">
      <h1>{title}</h1>
    </header>
    <RuntimeSettings client:load locale={locale} config={getRuntimeConfig()} />
  </section>
</BaseLayout>
