---
import LinkButton from "../ui/astro/LinkButton.astro";
import BuildCard from "../features/builds/components/BuildCard.astro";
import ErrorPanel from "../features/catalogue/ErrorPanel.astro";
import Pagination from "../components/Pagination.astro";
import SearchComposer from "../features/search/SearchComposer.svelte";
import CatalogueLayout from "../layouts/CatalogueLayout.astro";
import { asCatalogueError, fetchBuilds } from "../lib/api";
import { localizePath, translate, type Locale } from "../lib/i18n";
import { isPaged, PAGE_PARAMS, readPageParams } from "../lib/pagination";
import { searchStateFromUrl } from "../lib/search";

type Props = { locale: Locale };
const { locale } = Astro.props;
const { guided, query: q, mode: initialMode, sort } = searchStateFromUrl(Astro.url.searchParams);
const page_ = readPageParams(Astro.url.searchParams);
const canonicalUrl = new URL(Astro.url);
for (const name of PAGE_PARAMS) canonicalUrl.searchParams.delete(name);
let error;
let page;
try {
  // The composer's sort vocabulary is the search field registry's, which the catalogue listing
  // does not share: without a query, its allowlist is the indexed columns only.
  page = await fetchBuilds(locale, { q, sort: q ? sort : undefined, ...page_ });
} catch (caught) {
  error = asCatalogueError(caught);
  Astro.locals.responseStatus = error.status;
}
---

<CatalogueLayout
  title={translate(locale, "builds.title")}
  description={translate(locale, "meta.buildsDescription")}
  locale={locale}
  canonicalPath={`${canonicalUrl.pathname}${canonicalUrl.search}`}
  noindex={isPaged(page_) || Boolean(error)}
>
  <div class="catalogue-container catalogue-stack">
    <header class="catalogue-heading">
      <div class="sq-kicker">{translate(locale, "site.tagline")}</div>
      <h1>{translate(locale, "builds.title")}</h1>
      <p class="sq-lede">{translate(locale, "builds.intro")}</p>
    </header>
    <SearchComposer
      client:load
      locale={locale}
      action={localizePath("/builds", locale)}
      initialGuided={guided}
      initialQuery={q ?? ""}
      initialSort={sort ?? ""}
      initialMode={initialMode}
    />
    {error ? (
      <ErrorPanel
        locale={locale}
        error={error}
        retryHref={`${Astro.url.pathname}${Astro.url.search}`}
      />
    ) : page!.items.length > 0 ? (
      <section class="catalogue-results" aria-labelledby="catalogue-results">
        <h2 id="catalogue-results">
          {q ? translate(locale, "search.results") : translate(locale, "builds.latest")}
        </h2>
        <div class="catalogue-grid">
          {page!.items.map((build) => (
            <BuildCard build={build} locale={locale} />
          ))}
        </div>
        <Pagination locale={locale} next={page!.next} prev={page!.prev} url={Astro.url} />
      </section>
    ) : (
      <section class="sq-panel catalogue-empty">
        <h2>{translate(locale, "catalogue.emptyTitle")}</h2>
        <p class="sq-muted">{translate(locale, "builds.empty")}</p>
        <LinkButton href={localizePath("/builds", locale)}>
          {translate(locale, "catalogue.clear")}
        </LinkButton>
      </section>
    )}
  </div>
</CatalogueLayout>
