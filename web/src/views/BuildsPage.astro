---
import BuildCard from "../components/BuildCard.astro";
import ErrorState from "../components/ErrorState.astro";
import Pagination from "../components/Pagination.astro";
import SearchComposer from "../components/SearchComposer";
import BaseLayout from "../layouts/BaseLayout.astro";
import { asCatalogueError, fetchBuilds } from "../lib/api";
import { localizePath, translate, type Locale } from "../lib/i18n";
import { isPaged, PAGE_PARAMS, readPageParams } from "../lib/pagination";
import { composeGuidedQuery, queryFromUrl } from "../lib/search";

type Props = { locale: Locale };
const { locale } = Astro.props;
const guided = queryFromUrl(Astro.url.searchParams);
const guidedQuery = composeGuidedQuery(guided);
const q = Astro.url.searchParams.get("q")?.trim() || guidedQuery || undefined;
const sort = Astro.url.searchParams.get("sort")?.trim() || undefined;
const page_ = readPageParams(Astro.url.searchParams);
const hasGuidedParameters = Object.values(guided).some(Boolean);
const initialMode = q && !hasGuidedParameters ? "advanced" : "guided";
const canonicalUrl = new URL(Astro.url);
for (const name of PAGE_PARAMS) canonicalUrl.searchParams.delete(name);
let error;
let page;
try {
  // The composer's sort vocabulary is the search field registry's, which the catalogue listing
  // does not share: without a query, its allowlist is the indexed columns only.
  page = await fetchBuilds(locale, { q, sort: q ? sort : undefined, ...page_ });
} catch (caught) {
  error = asCatalogueError(caught);
  Astro.locals.responseStatus = error.status;
}
---

<BaseLayout
  title={translate(locale, "builds.title")}
  description={translate(locale, "meta.buildsDescription")}
  locale={locale}
  canonicalPath={`${canonicalUrl.pathname}${canonicalUrl.search}`}
  noindex={isPaged(page_)}
>
  <div class="page-shell section-stack">
    <header class="page-heading">
      <div class="eyebrow">{translate(locale, "site.tagline")}</div>
      <h1>{translate(locale, "builds.title")}</h1>
      <p class="lede">{translate(locale, "builds.intro")}</p>
    </header>
    <SearchComposer
      client:load
      locale={locale}
      action={localizePath("/builds", locale)}
      initialGuided={guided}
      initialQuery={q ?? ""}
      initialSort={sort ?? ""}
      initialMode={initialMode}
    />
    {
      error ? (
        <ErrorState
          locale={locale}
          error={error}
          retryHref={`${Astro.url.pathname}${Astro.url.search}`}
        />
      ) : page!.items.length > 0 ? (
        <section aria-labelledby="catalogue-results">
          <h2 id="catalogue-results">
            {q ? translate(locale, "search.results") : translate(locale, "builds.latest")}
          </h2>
          <div class="card-grid">
            {page!.items.map((build) => (
              <BuildCard build={build} locale={locale} />
            ))}
          </div>
          <Pagination locale={locale} next={page!.next} prev={page!.prev} url={Astro.url} />
        </section>
      ) : (
        <div class="empty-state">{translate(locale, "builds.empty")}</div>
      )
    }
  </div>
</BaseLayout>
