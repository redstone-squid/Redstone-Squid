---
import LinkButton from "../ui/astro/LinkButton.astro";
import BuildCard from "../features/builds/components/BuildCard.astro";
import ErrorPanel from "../features/catalogue/ErrorPanel.astro";
import Pagination from "../components/Pagination.astro";
import SearchComposer from "../features/search/SearchComposer.svelte";
import CatalogueLayout from "../layouts/CatalogueLayout.astro";
import { asCatalogueError, fetchSearch } from "../lib/api";
import { localizePath, translate, type Locale } from "../lib/i18n";
import { PAGE_PARAMS, readOffset } from "../lib/pagination";
import { searchStateFromUrl } from "../lib/search";

type Props = { locale: Locale };
const { locale } = Astro.props;
const { guided, query: q, mode: initialMode, sort } = searchStateFromUrl(Astro.url.searchParams);
const offset = readOffset(Astro.url.searchParams);
const canonicalUrl = new URL(Astro.url);
for (const name of PAGE_PARAMS) canonicalUrl.searchParams.delete(name);
let error;
let page;
if (q) {
  try {
    page = await fetchSearch(locale, { q, sort, offset });
  } catch (caught) {
    error = asCatalogueError(caught);
    Astro.locals.responseStatus = error.status;
  }
}
---

<CatalogueLayout
  title={translate(locale, "search.title")}
  description={translate(locale, "meta.searchDescription")}
  locale={locale}
  canonicalPath={`${canonicalUrl.pathname}${canonicalUrl.search}`}
  noindex={Boolean(offset || error)}
>
  <div class="catalogue-container catalogue-stack">
    <header class="catalogue-heading">
      <div class="sq-kicker">{translate(locale, "site.tagline")}</div>
      <h1>{translate(locale, "search.title")}</h1>
      <p class="sq-lede">{translate(locale, "search.intro")}</p>
    </header>
    <SearchComposer
      client:load
      locale={locale}
      action={localizePath("/search", locale)}
      initialGuided={guided}
      initialQuery={q}
      initialSort={sort ?? ""}
      initialMode={initialMode}
    />
    {error ? (
      <ErrorPanel
        locale={locale}
        error={error}
        retryHref={`${Astro.url.pathname}${Astro.url.search}`}
      />
    ) : !q ? (
      <div class="sq-panel catalogue-empty">{translate(locale, "search.prompt")}</div>
    ) : page!.items.length === 0 ? (
      <section class="sq-panel catalogue-empty">
        <h2>{translate(locale, "catalogue.emptyTitle")}</h2>
        <p class="sq-muted">{translate(locale, "search.empty")}</p>
        <LinkButton href={localizePath("/search", locale)}>
          {translate(locale, "catalogue.clear")}
        </LinkButton>
      </section>
    ) : (
      <section class="catalogue-results" aria-labelledby="search-results-heading">
        <h2 id="search-results-heading">{translate(locale, "search.results")}</h2>
        <div class="catalogue-grid">
          {page!.items.map((result) => {
            if ("build" in result) return <BuildCard build={result.build} locale={locale} />;
            if ("record" in result)
              return (
                <article class="sq-panel catalogue-record">
                  <span class="sq-badge">{translate(locale, "search.resultRecord")}</span>
                  <div>
                    <h2>{result.record.title}</h2>
                    <p>{result.record.subtitle ?? result.record.build_title}</p>
                  </div>
                  <a
                    class="sq-button sq-button--secondary"
                    href={localizePath(`/records/${result.record.record_id}`, locale)}
                  >
                    {translate(locale, "common.viewRecord")}
                  </a>
                </article>
              );
            return (
              <article class="sq-panel catalogue-record">
                <span class="sq-badge">{translate(locale, "search.resultMetadata")}</span>
                <div>
                  <h2>{result.metadata.title}</h2>
                  <p>{result.metadata.description ?? result.metadata.aliases.join(" · ")}</p>
                </div>
                <span class="sq-badge">{result.metadata.metadata_kind}</span>
              </article>
            );
          })}
        </div>
        <Pagination locale={locale} next={page!.next} prev={page!.prev} url={Astro.url} />
      </section>
    )}
  </div>
</CatalogueLayout>
