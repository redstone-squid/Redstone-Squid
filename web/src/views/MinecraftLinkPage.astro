---
import MinecraftLink from "../components/MinecraftLink";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getRuntimeConfig } from "../lib/config";
import { translate, localizePath, type Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const config = getRuntimeConfig();
const rawCode = Astro.url.searchParams.get("code") ?? "";
const initialCode = /^[A-Za-z2-7-]{8,32}$/.test(rawCode) ? rawCode : "";
const content = {
  title: translate(locale, "minecraftPage.title"),
  description: translate(locale, "minecraftPage.description"),
  eyebrow: translate(locale, "minecraftPage.eyebrow"),
  intro: translate(locale, "minecraftPage.intro"),
};
---

<BaseLayout
  title={content.title}
  description={content.description}
  locale={locale}
  canonicalPath={localizePath("/minecraft/link", locale)}
  noindex
>
  <section class="page-shell minecraft-link-page">
    <header class="page-heading submission-heading">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p>{content.intro}</p>
    </header>
    <MinecraftLink client:load locale={locale} config={config} initialCode={initialCode} />
  </section>
</BaseLayout>
