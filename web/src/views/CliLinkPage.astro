---
import CliLink from "../components/CliLink";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getRuntimeConfig } from "../lib/config";
import { translate, localizePath, type Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const config = getRuntimeConfig();
const content = {
  title: translate(locale, "cliPage.title"),
  description: translate(locale, "cliPage.description"),
  eyebrow: translate(locale, "cliPage.eyebrow"),
  intro: translate(locale, "cliPage.intro"),
};
---

<BaseLayout
  title={content.title}
  description={content.description}
  locale={locale}
  canonicalPath={localizePath("/cli/link", locale)}
  noindex
>
  <section class="page-shell cli-link-page">
    <header class="page-heading submission-heading">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p>{content.intro}</p>
    </header>
    <CliLink client:load locale={locale} config={config} />
  </section>
</BaseLayout>
