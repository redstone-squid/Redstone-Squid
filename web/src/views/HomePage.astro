---
import BuildCard from "../features/builds/components/BuildCard.astro";
import ErrorPanel from "../features/catalogue/ErrorPanel.astro";
import RecordSummary from "../features/catalogue/RecordSummary.astro";
import CatalogueLayout from "../layouts/CatalogueLayout.astro";
import LinkButton from "../ui/astro/LinkButton.astro";
import { asCatalogueError, fetchBuilds, fetchRecords } from "../lib/api";
import { getRuntimeConfig } from "../lib/config";
import { localizePath, translate, type Locale, type StaticMessageKey } from "../lib/i18n";
type Props = { locale: Locale };
const { locale } = Astro.props;
const t = (key: StaticMessageKey) => translate(locale, key);
const config = getRuntimeConfig();
const [buildResult, recordResult] = await Promise.allSettled([
  fetchBuilds(locale, { pageSize: 6 }),
  fetchRecords(locale, { pageSize: 3 }),
]);
const builds = buildResult.status === "fulfilled" ? buildResult.value : undefined;
const records = recordResult.status === "fulfilled" ? recordResult.value : undefined;
const buildError =
  buildResult.status === "rejected" ? asCatalogueError(buildResult.reason) : undefined;
const recordError =
  recordResult.status === "rejected" ? asCatalogueError(recordResult.reason) : undefined;
const error = buildError ?? recordError;
if (error) Astro.locals.responseStatus = error.status;
const searchAction = localizePath("/builds", locale);
const featured = builds?.items[0];
---

<CatalogueLayout
  title={t("nav.home")}
  {locale}
  canonicalPath={localizePath("/", locale)}
  noindex={Boolean(error)}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: t("site.name"),
    url: new URL(localizePath("/", locale), config.siteUrl).toString(),
    potentialAction: {
      "@type": "SearchAction",
      target: `${new URL(searchAction, config.siteUrl)}?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  }}
>
  <section class="catalogue-hero">
    <div class="catalogue-container catalogue-hero-inner">
      <div>
        <p class="sq-kicker">{t("home.eyebrow")}</p>
        <h1>{t("home.title")}</h1>
        <p class="sq-lede">{t("home.intro")}</p>
        <form class="catalogue-search" method="get" action={searchAction}>
          <input type="hidden" name="mode" value="guided" />
          <div class="sq-field">
            <label for="home-keywords">{t("search.keywords")}</label>
            <input class="sq-input" id="home-keywords" name="keywords" type="search" />
          </div>
          <button class="sq-button sq-button--primary" type="submit">
            {t("search.submit")} <span aria-hidden="true">→</span>
          </button>
        </form>
        <div class="sq-row catalogue-hero-links">
          <a href={searchAction}>{t("catalogue.browse")} →</a>
          <a href={localizePath("/records", locale)}>{t("nav.records")}</a>
        </div>
      </div>
      {featured && (
        <div class="catalogue-feature">
          <h2 class="sq-kicker">{t("catalogue.featured")}</h2>
          <BuildCard build={featured} {locale} eager />
        </div>
      )}
    </div>
  </section>
  <div class="catalogue-container catalogue-stack">
    {builds?.items.length !== 1 && (
      <section aria-labelledby="latest-heading">
        <div class="catalogue-section-heading">
          <div>
            <h2 id="latest-heading">{t("home.latest")}</h2>
            <p class="sq-muted">{t("home.latestIntro")}</p>
          </div>
          <LinkButton href={searchAction}>{t("nav.builds")} →</LinkButton>
        </div>
        {buildError ? (
          <ErrorPanel {locale} error={buildError} retryHref={localizePath("/", locale)} />
        ) : builds!.items.length > 1 ? (
          <div class="catalogue-grid">
            {builds!.items.slice(1).map((build) => (
              <BuildCard {build} {locale} />
            ))}
          </div>
        ) : !featured ? (
          <p class="sq-panel sq-muted">{t("builds.empty")}</p>
        ) : null}
      </section>
    )}
    <section aria-labelledby="records-heading">
      <div class="catalogue-section-heading">
        <div>
          <h2 id="records-heading">{t("home.records")}</h2>
          <p class="sq-muted">{t("home.recordsIntro")}</p>
        </div>
        <LinkButton href={localizePath("/records", locale)}>{t("nav.records")} →</LinkButton>
      </div>
      {recordError ? (
        <ErrorPanel {locale} error={recordError} retryHref={localizePath("/", locale)} />
      ) : records!.items.length ? (
        <div class="catalogue-grid">
          {records!.items.map((record) => (
            <RecordSummary {record} {locale} />
          ))}
        </div>
      ) : (
        <p class="sq-panel sq-muted">{t("records.empty")}</p>
      )}
    </section>
    <section class="catalogue-community">
      <div>
        <h2>{t("home.communityTitle")}</h2>
        <p>{t("home.communityBody")}</p>
      </div>
      <div class="sq-row">
        <LinkButton href={config.discordCommunityUrl} variant="primary" rel="noreferrer">
          {t("footer.discord")}
        </LinkButton>
        <LinkButton href={config.botInviteUrl} rel="noreferrer">
          {t("footer.invite")}
        </LinkButton>
      </div>
    </section>
  </div>
</CatalogueLayout>
