---
import SubmissionFlow from "../components/SubmissionFlow";
import "../ui/tokens.css";
import "../ui/components.css";
import "../ui/patterns.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getRuntimeConfig } from "../lib/config";
import { translate, localizePath, type Locale } from "../lib/i18n";

type Props = { locale: Locale };

const { locale } = Astro.props;
const config = getRuntimeConfig();
const content = {
  title: translate(locale, "submissionPage.title"),
  description: translate(locale, "submissionPage.description"),
  eyebrow: translate(locale, "submissionPage.eyebrow"),
  intro: translate(locale, "submissionPage.intro"),
};
---

<BaseLayout
  title={content.title}
  description={content.description}
  locale={locale}
  canonicalPath={localizePath("/submit", locale)}
  noindex
>
  <section class="page-shell submission-page">
    <header class="page-heading submission-heading">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p>{content.intro}</p>
    </header>
    <SubmissionFlow client:load locale={locale} config={config} />
  </section>
</BaseLayout>
