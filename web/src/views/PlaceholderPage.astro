---
import CatalogueLayout from "../layouts/CatalogueLayout.astro";
import { localeFromPath, localizePath, translate, type StaticMessageKey } from "../lib/i18n";
import Layout from "../ui/astro/Layout.astro";
import LinkButton from "../ui/astro/LinkButton.astro";

type Props = { titleKey: StaticMessageKey; home?: true } | { status: 404 | 503 };

const props = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const status = "status" in props ? props.status : undefined;
const home = "home" in props && props.home;
if (status) Astro.locals.responseStatus = status;
const title = translate(
  locale,
  "titleKey" in props
    ? props.titleKey
    : status === 404
      ? "error.notFoundTitle"
      : "error.serviceTitle",
);
const description = translate(
  locale,
  status === 404
    ? "error.notFoundBody"
    : status === 503
      ? "error.serviceBody"
      : "placeholder.rebuilding",
);
---

<CatalogueLayout {title} {description} {locale} noindex={!home}>
  <Layout pattern="stack" gap="normal" class="catalogue-container placeholder">
    <h1>{title}</h1>
    <p>{description}</p>
    <div>
      {status ? (
        <LinkButton href={localizePath("/", locale)}>{translate(locale, "common.home")}</LinkButton>
      ) : (
        <LinkButton href={`/design-system?lang=${locale}`}>
          {translate(locale, "workbench.page-title")}
        </LinkButton>
      )}
    </div>
  </Layout>
</CatalogueLayout>

<style>
  .placeholder {
    padding-block: var(--space-8);
  }
</style>
