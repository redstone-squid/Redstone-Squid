---
import ErrorState from "../components/ErrorState.astro";
import MediaGallery from "../components/MediaGallery";
import BaseLayout from "../layouts/BaseLayout.astro";
import { asCatalogueError, CatalogueApiError, fetchBuild, fetchSchematics } from "../lib/api";
import type { BuildDetail, PageSchematicSummary } from "../generated/types.gen";
import {
  formatDate,
  formatNumber,
  localizePath,
  translate,
  translateTaxonomy,
  type Locale,
} from "../lib/i18n";
import {
  buildMedia,
  externalLinks,
  formatDimensions,
  formatTag,
  formatTiming,
} from "../lib/view-models";
import { readPositiveInteger } from "../lib/search";

type Props = { locale: Locale; id: string };
const { locale } = Astro.props;
const buildId = readPositiveInteger(Astro.props.id);
let error;
let build: BuildDetail | undefined;
let schematics: PageSchematicSummary | undefined;
if (!buildId) {
  error = new CatalogueApiError(404);
  Astro.locals.responseStatus = 404;
} else {
  try {
    [build, schematics] = await Promise.all([
      fetchBuild(locale, buildId),
      fetchSchematics(locale, buildId),
    ]);
  } catch (caught) {
    error = asCatalogueError(caught);
    Astro.locals.responseStatus = error.status;
  }
}
const media = build ? buildMedia(build) : [];
const canonicalPath = buildId ? localizePath(`/builds/${buildId}`, locale) : Astro.url.pathname;
const description =
  build?.description?.slice(0, 220) ||
  (build ? `${build.title} — ${translate(locale, "meta.buildsDescription")}` : undefined);
const restrictionGroups = build
  ? Object.entries(build.restrictions).filter(([, values]) => values.length > 0)
  : [];
const linkGroups = build
  ? (
      [
        ["build.videos", externalLinks(build.links.videos)],
        ["build.worlds", externalLinks(build.links.world_downloads)],
        ["build.schematics", externalLinks(build.links.schematics)],
      ] as const
    ).filter(([, links]) => links.length > 0)
  : [];
---

<BaseLayout
  title={build?.title ?? translate(locale, "error.notFoundTitle")}
  description={description}
  locale={locale}
  canonicalPath={canonicalPath}
  image={media[0]?.url}
  noindex={Boolean(error)}
  structuredData={build
    ? {
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        name: build.title,
        description: build.description,
        creator: build.creators.map((name) => ({ "@type": "Person", name })),
        image: media.map((item) => item.url),
        dateCreated: build.created_at,
        dateModified: build.updated_at,
        url: canonicalPath,
      }
    : undefined}
>
  {
    error ? (
      <ErrorState locale={locale} error={error} retryHref={Astro.url.pathname} />
    ) : (
      <div class="page-shell section-stack">
        <header class="detail-header">
          <div>
            <div class="eyebrow">{translate(locale, "build.detail", { id: build!.id })}</div>
            <h1>{build!.title}</h1>
            <ul class="card-meta">
              <li>{translateTaxonomy(locale, build!.category)}</li>
              <li>{translateTaxonomy(locale, build!.status)}</li>
              {build!.updated_at && (
                <li>
                  {translate(locale, "build.updated", {
                    date: formatDate(locale, build!.updated_at),
                  })}
                </li>
              )}
            </ul>
          </div>
          <span class="chip">REV {build!.revision}</span>
        </header>

        {media.length > 0 && (
          <MediaGallery client:load items={media} locale={locale} title={build!.title} />
        )}

        <div class="detail-grid">
          <div class="detail-main">
            {build!.description && (
              <section class="surface">
                <h2>{translate(locale, "build.description")}</h2>
                <p class="text-content">{build!.description}</p>
              </section>
            )}
            <section class="surface">
              <h2>{translate(locale, "build.specification")}</h2>
              <dl class="spec-list">
                <div>
                  <>
                    <dt>{translate(locale, "build.dimensions")}</dt>
                    <dd>{formatDimensions(locale, build!.dimensions)}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{translate(locale, "build.doorDimensions")}</dt>
                    <dd>{formatDimensions(locale, build!.door_dimensions)}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{translate(locale, "build.opening")}</dt>
                    <dd>{formatTiming(locale, build!.opening_time)}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{translate(locale, "build.closing")}</dt>
                    <dd>{formatTiming(locale, build!.closing_time)}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{translate(locale, "build.orientation")}</dt>
                    <dd>{build!.orientation ?? translate(locale, "common.notAvailable")}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>{translate(locale, "build.versionSpec")}</dt>
                    <dd>{build!.version_spec ?? translate(locale, "common.notAvailable")}</dd>
                  </>
                </div>
              </dl>
            </section>
            {restrictionGroups.length > 0 && (
              <section class="surface">
                <h2>{translate(locale, "build.restrictions")}</h2>
                <div class="stack">
                  {restrictionGroups.map(([name, values]) => (
                    <div>
                      <div class="spec-label">{translateTaxonomy(locale, name)}</div>
                      <ul>
                        {values.map((value) => (
                          <li>{value}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </section>
            )}
            <section class="surface">
              <h2>{translate(locale, "build.analysis")}</h2>
              {schematics!.items.length > 0 ? (
                <div class="stack">
                  {schematics!.items.map((schematic) => (
                    <article>
                      <h3>
                        {schematic.filename ?? schematic.format}{" "}
                        {schematic.primary && (
                          <span class="chip">{translate(locale, "build.primary")}</span>
                        )}
                      </h3>
                      <ul class="card-meta">
                        <li>{schematic.format}</li>
                        <li>{formatDimensions(locale, schematic.dimensions)}</li>
                        <li>
                          {translate(locale, "build.blocks", {
                            count: formatNumber(locale, schematic.block_count),
                          })}
                        </li>
                        <li>
                          {translate(locale, "build.bytes", {
                            count: formatNumber(locale, schematic.byte_size),
                          })}
                        </li>
                      </ul>
                    </article>
                  ))}
                </div>
              ) : (
                <p>{translate(locale, "build.analysisEmpty")}</p>
              )}
            </section>
          </div>

          <aside class="detail-aside">
            <section class="surface">
              <h2>{translate(locale, "build.creators")}</h2>
              <ul class="link-list">
                {build!.creators.map((creator) => (
                  <li>
                    <a href={localizePath(`/creators/${encodeURIComponent(creator)}`, locale)}>
                      {creator}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
            {build!.versions.length > 0 && (
              <section class="surface">
                <h2>{translate(locale, "build.versions")}</h2>
                <ul class="chip-list">
                  {build!.versions.map((version) => (
                    <li class="chip">{version}</li>
                  ))}
                </ul>
              </section>
            )}
            {build!.patterns.length > 0 && (
              <section class="surface">
                <h2>{translate(locale, "build.patterns")}</h2>
                <ul class="chip-list">
                  {build!.patterns.map((pattern) => (
                    <li class="chip">{pattern}</li>
                  ))}
                </ul>
              </section>
            )}
            {build!.tags.length > 0 && (
              <section class="surface">
                <h2>{translate(locale, "build.tags")}</h2>
                <ul class="chip-list">
                  {build!.tags.map((tag) => (
                    <li class="chip">{formatTag(locale, tag)}</li>
                  ))}
                </ul>
              </section>
            )}
            {linkGroups.length > 0 && (
              <section class="surface">
                <h2>{translate(locale, "build.links")}</h2>
                <div class="stack">
                  {linkGroups.map(([label, links]) => (
                    <div>
                      <h3>{translate(locale, label)}</h3>
                      <ul class="link-list">
                        {links.map((link, index) => (
                          <li>
                            <a href={link} target="_blank" rel="noreferrer">
                              {translate(locale, label)} {index + 1}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </section>
            )}
          </aside>
        </div>
      </div>
    )
  }
</BaseLayout>
