---
import ErrorState from "../components/ErrorState.astro";
import Pagination from "../components/Pagination.astro";
import RecordCard from "../components/RecordCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { asCatalogueError, fetchRecords } from "../lib/api";
import { translate, type Locale } from "../lib/i18n";
import { isPaged, PAGE_PARAMS, readPageParams } from "../lib/pagination";

type Props = { locale: Locale };
const { locale } = Astro.props;
const page_ = readPageParams(Astro.url.searchParams);
const canonicalUrl = new URL(Astro.url);
for (const name of PAGE_PARAMS) canonicalUrl.searchParams.delete(name);
let error;
let page;
try {
  page = await fetchRecords(locale, page_);
} catch (caught) {
  error = asCatalogueError(caught);
  Astro.locals.responseStatus = error.status;
}
---

<BaseLayout
  title={translate(locale, "records.title")}
  description={translate(locale, "meta.recordsDescription")}
  locale={locale}
  canonicalPath={`${canonicalUrl.pathname}${canonicalUrl.search}`}
  noindex={isPaged(page_)}
>
  <div class="page-shell section-stack">
    <header class="page-heading">
      <div class="eyebrow">{translate(locale, "site.tagline")}</div>
      <h1>{translate(locale, "records.title")}</h1>
      <p class="lede">{translate(locale, "records.intro")}</p>
    </header>
    {
      error ? (
        <ErrorState locale={locale} error={error} retryHref={Astro.url.pathname} />
      ) : page!.items.length > 0 ? (
        <section class="card-grid" aria-label={translate(locale, "records.title")}>
          {page!.items.map((record) => (
            <RecordCard record={record} locale={locale} />
          ))}
        </section>
      ) : (
        <div class="empty-state">{translate(locale, "records.empty")}</div>
      )
    }
    {page && <Pagination locale={locale} next={page.next} prev={page.prev} url={Astro.url} />}
  </div>
</BaseLayout>
