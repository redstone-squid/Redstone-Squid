---
import type { HTMLAttributes } from "astro/types";
import { layoutStyles, type LayoutVariants } from "@/ui/variants";

type Props = HTMLAttributes<"div"> &
  LayoutVariants & {
    as?: "div" | "section" | "article" | "header" | "footer" | "main" | "aside" | "nav";
  };
const { as: Tag = "div", pattern, gap, class: className, ...rest } = Astro.props;
---

<Tag class={layoutStyles({ pattern, gap, className })} {...rest}>
  <slot />
</Tag>
