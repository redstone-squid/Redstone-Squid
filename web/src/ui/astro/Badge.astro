---
type Props = { tone?: "neutral" | "success" | "warning" };
const { tone = "neutral" } = Astro.props;
const dot =
  "before:me-[0.5em] before:size-[0.45em] before:self-center before:rounded-full before:bg-current";
const tones = {
  neutral: "bg-surface-muted text-fg-muted",
  success: `${dot} bg-success-soft text-success`,
  warning: `${dot} bg-warning-soft text-warning`,
};
---

<span
  class:list={["inline-flex w-fit rounded-sm px-2 py-1 text-[0.6875rem] font-[650]", tones[tone]]}
>
  <slot />
</span>
