---
import * as m from "@/locales/messages.gen";
import Layout from "@/ui/astro/Layout.astro";
import Panel from "@/ui/astro/Panel.astro";
import StoryOptions from "./StoryOptions.astro";
import { selectedOption } from "./story-option";
import { buildFixtures } from "./fixtures";
const patterns = { stack: m.workbenchStack, row: m.workbenchRow, grid: m.workbenchGrid } as const;
const gaps = {
  compact: m.workbenchCompact,
  normal: m.workbenchNormal,
  section: m.workbenchSection,
} as const;
const pattern = selectedOption(patterns, Astro.url.searchParams, "layout", "grid");
const gap = selectedOption(gaps, Astro.url.searchParams, "gap", "normal");
const { creator, dimensions, timing } = buildFixtures[0];
---

<Panel id="layouts" title={m.workbenchLayouts()}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <StoryOptions
      label={m.workbenchLayouts()}
      parameter="layout"
      selected={pattern}
      section="layouts"
      options={patterns}
    />
    <StoryOptions
      label={m.workbenchSpacing()}
      parameter="gap"
      selected={gap}
      section="layouts"
      options={gaps}
    />
  </div>
  <div class="mt-4 mb-2 rounded-md border border-line bg-canvas p-4">
    <Layout {pattern} {gap}>
      {[
        [m.workbenchCreator(), creator],
        [m.workbenchDimensions(), dimensions],
        [m.workbenchOpening(), timing],
      ].map(([term, value]) => (
        <dl class="rounded-sm border border-line bg-surface p-3">
          <dt class="text-xs text-fg-muted">{term}</dt>
          <dd class="mt-1">{value}</dd>
        </dl>
      ))}
    </Layout>
  </div>
  <code class="text-xs text-fg-muted">{`<Layout pattern="${pattern}" gap="${gap}">`}</code>
</Panel>
