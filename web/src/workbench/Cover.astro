---
import * as m from "@/locales/messages.gen";
import type { Theme } from "@/ui/themes";
import { layoutStyles } from "@/ui/variants";
import ThemeToggle from "./ThemeToggle.svelte";

type Props = { theme: Theme };
const { theme } = Astro.props;
---

<header class="grid grid-cols-[1.15fr_1fr] overflow-hidden rounded-lg bg-cover text-cover-fg max-md:grid-cols-1">
  <div class="self-center p-[clamp(1.5rem,4vw,3.5rem)]">
    <h1 class="text-[clamp(2.25rem,4vw,4rem)]">{m.workbenchPageTitle()}</h1>
    <p class="mt-4 mb-6 max-w-[42rem] text-[1.0625rem] text-cover-fg-muted">
      {m.workbenchLibraryDescription()}
    </p>
    <div class={layoutStyles({ pattern: "row" })}>
      <ThemeToggle client:load {theme} />
    </div>
  </div>
  <div aria-hidden="true" class="grid place-items-center overflow-hidden bg-cover-art max-md:h-36">
    <img
      class="size-full object-cover max-md:h-36 max-md:object-contain"
      src="/fixtures/copper-door.svg"
      alt=""
      width="640"
      height="400"
    />
  </div>
</header>
