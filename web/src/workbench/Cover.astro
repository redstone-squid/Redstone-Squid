---
import * as m from "@/locales/messages.gen";
---

<header class="grid grid-cols-[minmax(0,1fr)] overflow-hidden rounded-lg bg-cover text-cover-fg md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
  <div class="grid content-center gap-4 p-6 md:p-12">
    <h1 class="text-3xl font-bold tracking-tight md:text-display md:tracking-display">
      {m.workbenchPageTitle()}
    </h1>
    <p class="max-w-prose text-lg text-cover-fg-muted">{m.workbenchLibraryDescription()}</p>
  </div>
  <div aria-hidden="true" class="grid h-36 place-items-center bg-cover-art md:h-auto">
    <img
      class="size-full object-contain md:object-cover"
      src="/fixtures/copper-door.svg"
      alt=""
      width="640"
      height="400"
    />
  </div>
</header>
