---
import { localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import LinkButton from "@/ui/astro/LinkButton.astro";
import type { Theme } from "@/ui/themes";
import { cn } from "@/ui/cn";
import { buttonStyles, fieldClass, inputClass, layoutStyles } from "@/ui/variants";
import { selectedOption } from "./story-option";

type Props = { theme: Theme };
const { theme } = Astro.props;
const params = Astro.url.searchParams;
const variants = {
  primary: m.workbenchPrimary,
  secondary: m.workbenchSecondary,
  quiet: m.workbenchQuiet,
} as const;
const sizes = { normal: m.workbenchNormal, small: m.workbenchSmall } as const;
const variant = selectedOption(variants, params, "variant", "primary");
const size = selectedOption(sizes, params, "size", "normal");
const trial = new URLSearchParams({ theme });
---

<div
  class="mb-8 grid grid-cols-[minmax(10rem,0.8fr)_minmax(0,1.2fr)] overflow-hidden rounded-md border border-line max-md:grid-cols-1"
  id="button-story"
>
  <div class="grid min-h-36 place-items-center bg-canvas bg-radial-[circle] from-line from-[1px] to-transparent to-[1px] bg-size-[12px_12px] p-4">
    <LinkButton {variant} {size} href={localizePath(`/design-system-trial?${trial}`)}>
      {m.trialTitle()} <span aria-hidden="true">→</span>
    </LinkButton>
  </div>
  <div class="grid gap-3 p-4">
    <h3>{m.workbenchLinkButton()}</h3>
    <form action="#button-story" method="get" class={layoutStyles({ pattern: "actions" })}>
      {[...params]
        .filter(([key]) => key !== "variant" && key !== "size")
        .map(([key, value]) => (
          <input type="hidden" name={key} {value} />
        ))}
      <label class={cn(fieldClass, "font-semibold")}>
        {m.workbenchVariant()}
        <select class={inputClass} name="variant">
          {Object.entries(variants).map(([value, label]) => (
            <option value={value} selected={value === variant}>
              {label()}
            </option>
          ))}
        </select>
      </label>
      <label class={cn(fieldClass, "font-semibold")}>
        {m.workbenchSize()}
        <select class={inputClass} name="size">
          {Object.entries(sizes).map(([value, label]) => (
            <option value={value} selected={value === size}>
              {label()}
            </option>
          ))}
        </select>
      </label>
      <button class={buttonStyles({ size: "small" })} type="submit">
        {m.workbenchApply()}
      </button>
    </form>
    <code class="font-mono text-xs/[1.6] wrap-anywhere text-fg-muted">
      {`buttonStyles({ variant: "${variant}", size: "${size}" })`}
    </code>
  </div>
</div>
