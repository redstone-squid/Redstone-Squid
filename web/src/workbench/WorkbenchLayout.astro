---
import LanguageSelector from "@/layouts/LanguageSelector.astro";
import { localizePath, unprefixedPath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import "@fontsource-variable/inter";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/noto-sans-sc/400.css";
import "@fontsource/noto-sans-sc/600.css";
import "@/ui/app.css";
import SkipLink from "@/ui/content/SkipLink.svelte";
import NavList from "@/ui/navigation/NavList.svelte";
import type { Theme } from "@/ui/themes";
import { GROUPS } from "./groups";
type Props = { title: string; theme: Theme };
const { title, theme } = Astro.props;
const { locale } = Astro.locals;
const path = unprefixedPath(Astro.url.pathname).replace(/\/$/, "");
// Every workbench link keeps the chosen theme.
const link = (route: string) => ({
  href: localizePath(`${route}?theme=${theme}`),
  current: path === route,
});
const groups = [
  {
    items: [
      { label: m.workbenchFoundations(), ...link("/design-system") },
      ...Object.entries(GROUPS).map(([slug, group]) => ({
        label: group.title,
        ...link(`/design-system/${slug}`),
      })),
      { label: m.trialTitle(), ...link("/design-system-trial") },
    ],
  },
];
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · {m.siteName()}</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <SkipLink href="#main" label={m.workbenchSkipToContent()} />
    <header class="flex items-center justify-between gap-4 border-b border-line bg-surface px-gutter py-4">
      <a class="flex items-center gap-3 rounded-sm font-bold no-underline" href={localizePath("/")}>
        <img class="size-8 shrink-0" src="/favicon.svg" width="32" height="32" alt="" />
        {m.siteName()}
      </a>
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-fg-muted max-sm:hidden">{m.workbenchWorkbench()}</span>
        <LanguageSelector />
      </div>
    </header>
    <div class="mx-auto grid max-w-wide md:grid-cols-[minmax(0,13rem)_minmax(0,1fr)]">
      <aside class="border-b border-line bg-surface px-gutter py-4 md:sticky md:top-0 md:self-start md:border-e md:border-b-0 md:px-4 md:py-10">
        <NavList label={m.workbenchWorkbench()} {groups} />
      </aside>
      <main id="main" class="grid w-full min-w-0 content-start gap-10 px-gutter py-10">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  /* Keep typographic specimens consistent across screenshot runners. */
  html {
    --font-sans: "Inter Variable", "Noto Sans SC", sans-serif;
    --font-mono: "JetBrains Mono Variable", "Noto Sans SC", monospace;
  }
</style>
