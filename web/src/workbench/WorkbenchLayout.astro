---
import faviconUrl from "@/ui/favicon.svg?url&no-inline";
import LanguageSelector from "@/layouts/LanguageSelector.astro";
import { unprefixedPath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import "@fontsource-variable/inter";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/noto-sans-sc/400.css";
import "@fontsource/noto-sans-sc/600.css";
import "@/ui/app.css";
import SkipLink from "@/ui/content/SkipLink.svelte";
import NavList from "@/ui/navigation/NavList.svelte";
import SegmentedControl from "@/ui/navigation/SegmentedControl.svelte";
import { workbench } from "./appearance";
import { GROUPS, groupNames } from "./groups";
type Props = { title: string };
const { title } = Astro.props;
const preview = workbench.at(Astro);
const controls = [
  {
    key: "theme",
    label: m.footerTheme(),
    current: preview.theme,
    options: [
      ["light", m.workbenchLightTheme()],
      ["dark", m.workbenchDarkTheme()],
    ],
  },
  {
    key: "contrast",
    label: m.footerContrast(),
    current: preview.contrast ?? "",
    options: [
      ["", m.workbenchDefaultContrast()],
      ["standard", m.footerContrastStandard()],
      ["more", m.footerContrastMore()],
    ],
  },
] as const;
const { locale } = Astro.locals;
const path = unprefixedPath(Astro.url.pathname).replace(/\/$/, "");
const link = (route: typeof workbench.index) => ({
  href: preview.nav.link(route),
  current: path === route.path,
});
const groups = [
  {
    items: [
      { label: m.workbenchFoundations(), ...link(workbench.index) },
      ...groupNames.map((slug) => ({
        label: GROUPS[slug].title(),
        ...link(workbench.group(slug)),
      })),
      { label: m.trialTitle(), ...link(workbench.trial) },
    ],
  },
];
---

<!doctype html>
<html lang={locale} data-theme={preview.theme} data-contrast={preview.effectiveContrast}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · {m.siteName()}</title>
    <link rel="icon" href={faviconUrl} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <SkipLink href="#main" label={m.workbenchSkipToContent()} />
    <header class="flex items-center justify-between gap-4 border-b border-line bg-surface px-gutter py-4">
      <a
        class="flex items-center gap-3 rounded-sm font-bold no-underline"
        href={preview.nav.link(workbench.home)}
      >
        <img class="size-8 shrink-0" src={faviconUrl} width="32" height="32" alt="" />
        {m.siteName()}
      </a>
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-fg-muted max-sm:hidden">{m.workbenchWorkbench()}</span>
        <LanguageSelector />
      </div>
    </header>
    <div class="mx-auto grid max-w-wide md:flex">
      <aside class="border-b border-line bg-surface px-gutter py-4 md:sticky md:top-0 md:w-52 md:shrink-0 md:self-start md:border-e md:border-b-0 md:px-4 md:py-10">
        <div class="mb-5 grid gap-3">
          {controls.map(({ key, label, current, options }) => (
            <div class="grid gap-1">
              <span class="text-sm text-fg-muted" aria-hidden="true">
                {label}
              </span>
              <SegmentedControl
                {label}
                items={options.map(([value, text]) => ({
                  label: text,
                  href: preview.nav.update({ [key]: value || null }),
                  current: value === current,
                }))}
              />
            </div>
          ))}
        </div>
        <NavList label={m.workbenchWorkbench()} {groups} />
      </aside>
      <main id="main" class="grid w-full min-w-0 content-start gap-10 px-gutter py-10">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  /* Keep typographic specimens consistent across screenshot runners. */
  html {
    --font-sans: "Inter Variable", "Noto Sans SC", sans-serif;
    --font-mono: "JetBrains Mono Variable", "Noto Sans SC", monospace;
  }
</style>
