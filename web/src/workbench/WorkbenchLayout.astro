---
import * as m from "../locales/messages";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/noto-sans-sc/400.css";
import "@fontsource/noto-sans-sc/600.css";
import "../ui/base.css";
import "./workbench-layout.css";
type Props = {
  title: string;
  locale: "en" | "zh-CN";
  theme: "light" | "dark";
};
const { title, locale, theme } = Astro.props;
const query = new URLSearchParams({ lang: locale, theme });
const library =
  Astro.url.pathname.replace(/\/$/, "") === "/design-system" ? "" : `/design-system?${query}`;
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Redstone Squid</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="sq-skip" href="#main">
      {m.workbenchSkipToContent(locale)}
    </a>
    <header class="sq-topbar">
      <a class="sq-brand" href="/">
        <img src="/favicon.svg" width="32" height="32" alt="" />
        Redstone Squid
      </a>
      <span class="sq-muted">{m.workbenchWorkbench(locale)}</span>
    </header>
    <div class="sq-shell">
      <aside class="sq-sidebar">
        <p class="sq-kicker">{m.workbenchWorkbench(locale)}</p>
        <nav aria-label={m.workbenchWorkbench(locale)}>
          <a href={`${library}#foundations`}>{m.workbenchFoundations(locale)}</a>
          <a href={`${library}#components`}>{m.workbenchComponents(locale)}</a>
          <a href={`${library}#fields`}>{m.workbenchFormControls(locale)}</a>
          <a href={`${library}#layouts`}>{m.workbenchLayouts(locale)}</a>
          <a href={`${library}#patterns`}>{m.workbenchPagePatterns(locale)}</a>
          <a href={`${library}#browsing`}>{m.workbenchBrowsing(locale)}</a>
          <a href={`${library}#states`}>{m.workbenchFeedbackStates(locale)}</a>
          <a href={`/design-system-trial?${query}`}>{m.trialTitle(locale)}</a>
        </nav>
        <p class="sq-sidebar-note">
          Astro + Svelte
          <br />
          Bits UI
        </p>
      </aside>
      <main id="main" class="sq-main">
        <slot />
      </main>
    </div>
  </body>
</html>
