---
import type { Locale } from "@/locales/locale";
import type { StoryOptionLabels } from "./story-option";

type Props = {
  locale: Locale;
  label: string;
  parameter: string;
  selected: string;
  section: string;
  options: StoryOptionLabels<string>;
};
const { locale, label, parameter, selected, section, options } = Astro.props;
---

<nav class="sq-story-options" aria-label={label}>
  {Object.entries(options).map(([value, optionLabel]) => {
    const params = new URLSearchParams(Astro.url.searchParams);
    params.set(parameter, value);
    return (
      <a href={`?${params}#${section}`} aria-current={value === selected ? "true" : undefined}>
        {optionLabel(locale)}
      </a>
    );
  })}
</nav>
