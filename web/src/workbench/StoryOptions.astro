---
import type { StoryOptionLabels } from "./story-option";

type Props = {
  label: string;
  parameter: string;
  selected: string;
  section: string;
  options: StoryOptionLabels<string>;
};
const { label, parameter, selected, section, options } = Astro.props;
---

<nav
  class="flex w-fit max-w-full flex-wrap gap-1 rounded-md bg-surface-muted p-1"
  aria-label={label}
>
  {Object.entries(options).map(([value, optionLabel]) => {
    const params = new URLSearchParams(Astro.url.searchParams);
    params.set(parameter, value);
    return (
      <a
        class="inline-flex min-h-9 items-center rounded-sm border border-transparent px-3 text-[0.8125rem] no-underline hover:underline aria-[current=true]:border-line aria-[current=true]:bg-surface aria-[current=true]:font-[650] forced-colors:aria-[current=true]:border-[Highlight]"
        href={`?${params}#${section}`}
        aria-current={value === selected ? "true" : undefined}
      >
        {optionLabel()}
      </a>
    );
  })}
</nav>
