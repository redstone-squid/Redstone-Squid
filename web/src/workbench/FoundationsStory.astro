---
import * as m from "@/locales/messages.gen";
import Panel from "@/ui/astro/Panel.astro";
import { cn } from "@/ui/cn";

// Static class names so Tailwind detects them; each swatch shows one theme color.
const swatches = {
  canvas: "bg-canvas",
  surface: "bg-surface",
  accent: "bg-accent",
  success: "bg-success",
  warning: "bg-warning",
  fg: "bg-fg",
} as const;
// Tailwind spacing steps the components use, in multiples of --spacing.
const spacingSteps = [1, 2, 3, 4, 6, 8, 12, 16];
---

<Panel
  id="foundations"
  title={m.workbenchFoundations()}
  description={m.workbenchFoundationsDescription()}
>
  <div class="grid grid-cols-6 max-md:grid-cols-3 max-md:gap-y-3">
    {Object.entries(swatches).map(([token, background]) => (
      <div class="group min-w-0">
        <div
          class={cn(
            "mb-2 h-[clamp(3rem,6vw,5.5rem)] border border-e-0 border-line group-first:rounded-l-md group-last:rounded-r-md group-last:border-e",
            background,
          )}
        />
        <code class="text-[0.6875rem] text-fg-muted">--{token}</code>
      </div>
    ))}
  </div>
  <div class="mt-6 grid gap-3 border-t border-line pt-4 text-xs text-fg-muted">
    <h3>{m.workbenchSpacing()}</h3>
    <div class="flex flex-wrap items-end gap-4">
      {spacingSteps.map((step) => (
        <div class="grid justify-items-start gap-2">
          <i class="h-2 rounded-[2px] bg-accent" style={`width:calc(var(--spacing) * ${step})`} />
          <code>--spacing × {step}</code>
        </div>
      ))}
    </div>
  </div>
  <details class="mt-4 border-t border-line pt-3">
    <summary class="cursor-pointer text-sm font-semibold">{m.workbenchTypography()}</summary>
    <div class="mt-3 grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-3">
      <div class="rounded-sm bg-canvas p-3">
        <code class="text-xs text-fg-muted">--font-sans</code>
        <p class="text-2xl">{m.workbenchPistonDoor()}</p>
      </div>
      <div class="rounded-sm bg-canvas p-3">
        <code class="text-xs text-fg-muted">--font-mono</code>
        <p class="font-mono text-2xl">5 × 5 × 3</p>
      </div>
    </div>
  </details>
</Panel>
