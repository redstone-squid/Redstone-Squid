---
import SummaryCard from "./SummaryCard.astro";
import Badge from "../../ui/astro/Badge.astro";
import RecordFreshness from "../../components/RecordFreshness.astro";
import type { PublishedTitle } from "../../generated/types.gen";
import { localizePath, translate, translateTaxonomy, type Locale } from "../../lib/i18n";
type Props = { record: PublishedTitle; locale: Locale; linked?: boolean };
const { record, locale, linked = true } = Astro.props;
---

<SummaryCard>
  <span class="sq-kicker">
    #{record.id} / {translateTaxonomy(locale, record.base_title)}
  </span>
  <h3>
    {linked ? (
      <a href={localizePath(`/records/${record.id}`, locale)}>{record.title}</a>
    ) : (
      record.title
    )}
  </h3>
  {record.subtitle && <p class="sq-muted">{record.subtitle}</p>}
  <div class="sq-row">
    <Badge>{translateTaxonomy(locale, record.build_kind)}</Badge>
    <Badge>{translateTaxonomy(locale, record.version_scope)}</Badge>
  </div>
  <p class="sq-muted">
    {translate(locale, "record.holderCount", { count: record.holder_build_ids.length })} ·{" "}
    <RecordFreshness {record} {locale} />
  </p>
</SummaryCard>
