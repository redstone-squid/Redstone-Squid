---
import SummaryCard from "./SummaryCard.astro";
import Badge from "../../ui/astro/Badge.astro";
import RecordFreshness from "./RecordFreshness.astro";
import type { PublishedRecordResult } from "../../generated/types.gen";
import { localizePath, type Locale } from "../../locales/locale";
import * as m from "../../locales/messages";
import { buildKindLabels, criterionLabels, versionScopeLabels } from "./vocabulary";
type Props = { record: PublishedRecordResult; locale: Locale; linked?: boolean };
const { record, locale, linked = true } = Astro.props;
---

<SummaryCard>
  <span class="sq-kicker">{criterionLabels[record.criterion](locale)}</span>
  <h3>
    {linked ? (
      <a href={localizePath(`/records/${record.record_id}`, locale)}>{record.title}</a>
    ) : (
      record.title
    )}
  </h3>
  {record.subtitle && <p class="sq-muted">{record.subtitle}</p>}
  <div class="sq-row">
    <Badge>{buildKindLabels[record.build_kind](locale)}</Badge>
    <Badge>{versionScopeLabels[record.version_scope](locale)}</Badge>
  </div>
  <p class="sq-muted">
    {m.recordHolderCount(locale, { count: record.holder_build_ids.length })} ·{" "}
    <RecordFreshness {record} {locale} />
  </p>
</SummaryCard>
