---
import type { PublishedTitle } from "../../generated/types.gen";
import { formatDate, translate, type Locale } from "../../lib/i18n";

type Props = { record: PublishedTitle; locale: Locale };
const { record, locale } = Astro.props;
---

<span>
  {record.last_checked_at
    ? translate(locale, "record.lastChecked", {
        date: formatDate(locale, record.last_checked_at),
      })
    : formatDate(locale, record.computed_at)}
  {record.refresh_pending && <> · {translate(locale, "record.refreshPending")}</>}
</span>
