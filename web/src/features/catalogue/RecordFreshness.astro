---
import type { PublishedRecordResult } from "../../generated/types.gen";
import type { Locale } from "../../locales/locale";
import * as m from "../../locales/messages";

type Props = { record: PublishedRecordResult; locale: Locale };
const { record, locale } = Astro.props;
---

<span>
  {record.last_checked_at
    ? m.recordLastChecked(locale, { date: record.last_checked_at })
    : m.recordComputed(locale, { date: record.computed_at })}
  {record.refresh_pending && <> · {m.recordRefreshPending(locale)}</>}
</span>
