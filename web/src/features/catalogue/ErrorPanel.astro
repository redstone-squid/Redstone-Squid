---
import type { CatalogueApiError } from "../../lib/api";
import { translate, type Locale } from "../../lib/i18n";
import LinkButton from "../../ui/astro/LinkButton.astro";
type Props = { locale: Locale; error: CatalogueApiError; retryHref: string };
const { locale, error, retryHref } = Astro.props;
---

<section class="sq-panel catalogue-error" aria-label={translate(locale, "error.title")}>
  <span class="sq-kicker">{translate(locale, "error.status", { status: error.status })}</span>
  <h2>
    {translate(
      locale,
      error.status === 404
        ? "error.notFoundTitle"
        : error.status < 500
          ? "error.title"
          : "error.serviceTitle",
    )}
  </h2>
  <p>
    {error.problem?.detail ??
      translate(locale, error.status === 404 ? "error.notFoundBody" : "error.serviceBody")}
  </p>
  {error.requestId && (
    <p class="sq-muted">{translate(locale, "error.reference", { id: error.requestId })}</p>
  )}
  <div>
    <LinkButton href={retryHref} variant="primary">
      {translate(locale, "common.retry")}
    </LinkButton>
  </div>
</section>
