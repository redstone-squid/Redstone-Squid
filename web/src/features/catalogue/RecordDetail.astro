---
import type { PublicRecordDetail } from "@/generated/types.gen";
import * as m from "@/locales/messages.gen";
import {
  buildKindLabel,
  recordCriterionLabel,
  resolutionStatusLabel,
  versionScopeLabel,
} from "@/locales/vocabulary.gen";
import Badge from "@/ui/astro/Badge.astro";
import Layout from "@/ui/astro/Layout.astro";
import Notice from "@/ui/astro/Notice.astro";
import PageHeading from "@/ui/astro/PageHeading.astro";
import { kickerClass, mutedClass } from "@/ui/variants";
import BuildCard from "./BuildCard.astro";
import RecordFreshness from "./RecordFreshness.astro";

/** A record with its classification, freshness, and holders in the API's order. */
type Props = { record: PublicRecordDetail };
const { record } = Astro.props;
const kind = buildKindLabel(record.build_kind);
---

<Layout pattern="stack" gap="section">
  <div class="grid gap-3">
    <span class={kickerClass}>{recordCriterionLabel(record.criterion)}</span>
    <PageHeading title={record.title} description={record.subtitle ?? undefined} />
    <Layout pattern="row" gap="compact">
      <Badge>{kind}</Badge>
      <Badge>{versionScopeLabel(record.version_scope)}</Badge>
      <Badge tone={record.status === "resolved" ? "success" : "warning"}>
        {m.recordStatus({ status: resolutionStatusLabel(record.status) })}
      </Badge>
    </Layout>
    <p class={mutedClass}>
      <RecordFreshness {record} />
    </p>
  </div>
  <section class="grid gap-4" aria-labelledby="record-holders">
    <h2 id="record-holders">{m.recordHolders()}</h2>
    {record.holder_builds.length === 0 ? (
      <Notice title={m.recordNoHolders()} />
    ) : (
      <ul class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,18rem),1fr))] gap-4">
        {record.holder_builds.map((build, index) => (
          <li>
            <BuildCard {build} category={kind} eager={index === 0} />
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
