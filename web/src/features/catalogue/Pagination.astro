---
import type { PageAnchor } from "@/generated/types.gen";
import * as m from "@/locales/messages.gen";
import { buttonStyles } from "@/ui/variants";
import { pageHref } from "./pagination";

/** Links to the pages around the current one, from the API's `prev` and `next` anchors. */
type Props = { next: PageAnchor | null; prev: PageAnchor | null; url: URL };
const { next, prev, url } = Astro.props;
---

{(prev || next) && (
  <nav class="flex justify-between gap-4" aria-label={m.navPagination()}>
    {prev ? (
      <a class={buttonStyles()} href={pageHref(url, prev)} rel="prev">
        {m.commonPrevious()}
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a class={buttonStyles()} href={pageHref(url, next)} rel="next">
        {m.commonNext()}
      </a>
    )}
  </nav>
)}
