---
import { cn } from "@/ui/cn";
import { mutedClass } from "@/ui/variants";
import Badge from "@/ui/astro/Badge.astro";

type Props = {
  build: {
    title: string;
    category: string;
    creator: string;
    dimensions: string;
    timing: string;
    image: { src: string; alt: string } | null;
  };
  labels: { noPreview: string; dimensions: string; opening: string; imageUnavailable?: string };
  href?: string;
  version?: string;
  eager?: boolean;
};
const { build, labels, href, version, eager = false } = Astro.props;
---

<article class="overflow-hidden rounded-md border border-line bg-surface">
  <div class="group relative aspect-8/5 bg-surface-muted">
    {build.image ? (
      <>
        <div class="invisible grid h-full content-center justify-items-center text-xs text-fg-muted group-has-[>img[hidden]]:visible">
          {labels.imageUnavailable ?? labels.noPreview}
        </div>
        <img
          src={build.image.src}
          width="640"
          height="400"
          alt={build.image.alt}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          class="absolute inset-0 size-full object-cover"
          referrerpolicy="no-referrer"
          onerror="this.hidden=true"
        />
      </>
    ) : (
      <div class="grid h-full content-center justify-items-center text-xs text-fg-muted">
        <span class="text-[3rem]" aria-hidden="true">
          ◇
        </span>
        {labels.noPreview}
      </div>
    )}
  </div>
  <div class="grid gap-2 p-4 wrap-anywhere">
    <Badge>{build.category}</Badge>
    <h3>
      {href ? (
        <a class="no-underline hover:underline" href={href}>
          {build.title}
        </a>
      ) : (
        build.title
      )}
    </h3>
    <p class={cn(mutedClass, "text-xs")}>{build.creator}</p>
    {version && <p class={cn(mutedClass, "font-mono text-[0.6875rem]")}>{version}</p>}
    <dl class="mt-2 flex gap-6 border-t border-line pt-3 text-xs">
      <div>
        <dt class="text-fg-muted">{labels.dimensions}</dt>
        <dd class="mt-1 font-mono">{build.dimensions}</dd>
      </div>
      <div>
        <dt class="text-fg-muted">{labels.opening}</dt>
        <dd class="mt-1 font-mono">{build.timing}</dd>
      </div>
    </dl>
  </div>
</article>
