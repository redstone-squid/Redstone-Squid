---
import type { BuildSummary } from "../../../generated/types.gen";
import { localizePath, translate, translateTaxonomy, type Locale } from "../../../lib/i18n";
import { cardPreview, formatDimensions, formatTiming } from "../../../lib/view-models";
import BuildPreview from "./BuildPreview.astro";
type Props = { build: BuildSummary; locale: Locale; eager?: boolean };
const { build, locale, eager } = Astro.props;
const preview = cardPreview(build);
const creator = build.credits?.length
  ? build.credits
      .map(
        (credit) =>
          `${credit.name}${credit.role !== "creator" ? ` (${translateTaxonomy(locale, credit.role)})` : ""}`,
      )
      .join(" · ")
  : build.creators.join(" · ");
---

<BuildPreview
  {eager}
  href={localizePath(`/builds/${build.id}`, locale)}
  version={build.versions[0]}
  build={{
    title: build.title,
    category: `#${build.id} / ${translateTaxonomy(locale, build.category)}`,
    creator,
    dimensions: formatDimensions(locale, build.dimensions),
    timing: formatTiming(locale, build.opening_time),
    image: preview ? { src: preview, alt: "" } : null,
  }}
  labels={{
    noPreview: translate(locale, "common.noImage"),
    imageUnavailable: translate(locale, "common.imageUnavailable"),
    dimensions: translate(locale, "build.dimensions"),
    opening: translate(locale, "build.opening"),
  }}
/>
