---
import "./build-preview.css";

type Props = {
  build: {
    title: string;
    category: string;
    creator: string;
    dimensions: string;
    timing: string;
    image: { src: string; alt: string } | null;
  };
  labels: { noPreview: string; dimensions: string; opening: string };
};
const { build, labels } = Astro.props;
---

<article class="sq-build-card">
  <div class="sq-build-image">
    {build.image ? (
      <img src={build.image.src} width="640" height="400" alt={build.image.alt} />
    ) : (
      <div class="sq-image-placeholder">
        <span aria-hidden="true">◇</span>
        {labels.noPreview}
      </div>
    )}
  </div>
  <div class="sq-build-body">
    <span class="sq-badge">{build.category}</span>
    <h3>{build.title}</h3>
    <p class="sq-muted">{build.creator}</p>
    <dl class="sq-metrics">
      <div>
        <dt>{labels.dimensions}</dt>
        <dd>{build.dimensions}</dd>
      </div>
      <div>
        <dt>{labels.opening}</dt>
        <dd>{build.timing}</dd>
      </div>
    </dl>
  </div>
</article>
