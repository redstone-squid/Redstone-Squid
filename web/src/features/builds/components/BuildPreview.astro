---
import "./build-preview.css";
import Badge from "../../../ui/astro/Badge.astro";

type Props = {
  build: {
    title: string;
    category: string;
    creator: string;
    dimensions: string;
    timing: string;
    image: { src: string; alt: string } | null;
  };
  labels: { noPreview: string; dimensions: string; opening: string; imageUnavailable?: string };
  href?: string;
  version?: string;
  eager?: boolean;
};
const { build, labels, href, version, eager = false } = Astro.props;
---

<article class="sq-build-card">
  <div class="sq-build-image">
    {build.image ? (
      <>
        <div class="sq-image-placeholder sq-image-error">
          {labels.imageUnavailable ?? labels.noPreview}
        </div>
        <img
          src={build.image.src}
          width="640"
          height="400"
          alt={build.image.alt}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          referrerpolicy="no-referrer"
          onerror="this.hidden=true"
        />
      </>
    ) : (
      <div class="sq-image-placeholder">
        <span aria-hidden="true">◇</span>
        {labels.noPreview}
      </div>
    )}
  </div>
  <div class="sq-build-body">
    <Badge>{build.category}</Badge>
    <h3>{href ? <a href={href}>{build.title}</a> : build.title}</h3>
    <p class="sq-muted">{build.creator}</p>
    {version && <p class="sq-muted sq-build-version">{version}</p>}
    <dl class="sq-metrics">
      <div>
        <dt>{labels.dimensions}</dt>
        <dd>{build.dimensions}</dd>
      </div>
      <div>
        <dt>{labels.opening}</dt>
        <dd>{build.timing}</dd>
      </div>
    </dl>
  </div>
</article>
