---
import type { DoorRecordEvidence } from "../generated/types.gen";
import { formatNumber, translate, translateTaxonomy, type Locale } from "../lib/i18n";
import { holderConfigurations } from "../lib/record-configurations";
import { formatTiming } from "../lib/view-models";

type Props = { evidence: DoorRecordEvidence; buildId: number; locale: Locale };
const { evidence, buildId, locale } = Astro.props;
const configurations = holderConfigurations(evidence, buildId);
const timingLabels = {
  opening: "build.opening",
  opening_visible: "record.openingVisible",
  closing: "build.closing",
  closing_visible: "record.closingVisible",
  opening_reset: "record.openingReset",
  closing_reset: "record.closingReset",
} as const;
const units = { game_tick: "gt", redstone_tick: "rt", second: "s", unknown: "unknown" };
---

{configurations.length > 0 && (
  <section
    class="surface record-configurations"
    aria-label={translate(locale, "record.configuration")}
  >
    <h3>{translate(locale, "record.configuration")}</h3>
    <p>
      {translate(locale, "build.doorDimensions")}: {evidence.evaluation.opening.join(" × ")}
    </p>
    {configurations.length > 1 && <p>{translate(locale, "record.alternativeConfigurations")}</p>}
    {configurations.map(({ configuration, branch, timings, excerpts }) => (
      <div class="record-configuration">
        {branch.label && <h4>{branch.label}</h4>}
        <dl class="spec-list">
          <div>
            <dt>{translate(locale, "record.parameters")}</dt>
            <dd>
              {configuration.parameters?.map(([name, value]) => `${name} = ${value}`).join(", ")}
            </dd>
          </div>
          <div>
            <dt>{translate(locale, "record.volume")}</dt>
            <dd>
              {configuration.volume == null
                ? translate(locale, "common.notAvailable")
                : formatNumber(locale, configuration.volume)}
            </dd>
          </div>
          {(configuration.timing_variants ?? []).map((values, index) => (
            <div>
              <dt>{translate(locale, "record.timingVariant", { number: index + 1 })}</dt>
              <dd>
                <ul>
                  {Object.values(timingLabels).map(
                    (key, method) =>
                      values[method] != null && (
                        <li>
                          {translate(locale, key)}: {formatTiming(locale, values[method])}
                        </li>
                      ),
                  )}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
        <details>
          <summary>{translate(locale, "record.sourceFormulas")}</summary>
          <p>
            {translate(locale, "build.doorDimensions")}:{" "}
            <code>
              {[branch.opening_width, branch.opening_height, branch.opening_depth].join(" × ")}
            </code>
          </p>
          {branch.volume && (
            <p>
              {translate(locale, "record.volume")}: <code>{branch.volume}</code>
            </p>
          )}
          {timings.map((timing) => (
            <p>
              {translate(locale, timingLabels[timing.method])}: <code>{timing.expression}</code> (
              {translateTaxonomy(locale, units[timing.unit ?? "unknown"])})
              {timing.variant && ` · ${timing.variant}`}
            </p>
          ))}
          {excerpts.map((excerpt) => (
            <blockquote>
              <p>{excerpt.text}</p>
            </blockquote>
          ))}
        </details>
      </div>
    ))}
  </section>
)}

<style>
  .record-configurations {
    margin-top: 1rem;
  }
  .record-configuration + .record-configuration {
    margin-top: 1.5rem;
  }
  code {
    overflow-wrap: anywhere;
  }
</style>
