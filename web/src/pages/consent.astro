---
import ConsentGate from "@/features/account/ConsentGate.svelte";
import { consentNoticeGet } from "@/generated/sdk.gen";
import CatalogueLayout from "@/layouts/CatalogueLayout.astro";
import { localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import { load } from "@/server/api";
import { grantConsent, returnPath, signOut } from "@/server/session";
import PageHeader from "@/ui/patterns/PageHeader.svelte";

const { session } = Astro.locals;
const redirectTo = returnPath(Astro.url.searchParams.get("redirect_to"));
const signIn = `${localizePath("/sign-in")}?redirect_to=${encodeURIComponent(redirectTo)}`;
let error: "stale" | "failed" | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("decision") === "decline") {
    await signOut(Astro);
    return Astro.redirect(redirectTo, 303);
  }
  const version = form.get("version");
  const outcome = await grantConsent(Astro, typeof version === "string" ? version : "");
  if (outcome === "granted") return Astro.redirect(redirectTo, 303);
  if (outcome === "signed-out") return Astro.redirect(signIn, 303);
  // A changed notice is shown again for a fresh answer; only a failure is an error status.
  error = outcome;
  if (outcome === "failed") Astro.response.status = 503;
} else if (session?.user == null) {
  return Astro.redirect(signIn);
} else if (!session.consent_pending) {
  return Astro.redirect(redirectTo);
}

const loaded = await load(consentNoticeGet({ client: Astro.locals.api }));
if ("status" in loaded) return Astro.rewrite(`/${loaded.status}`);
const notice = loaded.data;
---

<CatalogueLayout title={notice.title} canonicalPath="/consent" noindex>
  <PageHeader title={notice.title} description={m.consentDescription()} />
  <ConsentGate {notice} {error} />
</CatalogueLayout>
