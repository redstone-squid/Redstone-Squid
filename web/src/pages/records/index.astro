---
import RecordList from "@/features/catalogue/RecordList.svelte";
import { recordsList } from "@/generated/sdk.gen";
import CatalogueLayout from "@/layouts/CatalogueLayout.astro";
import * as m from "@/locales/messages.gen";
import { load } from "@/server/api";
import { pageHref, readPageAddress } from "@/server/pagination";
import PageHeader from "@/ui/patterns/PageHeader.svelte";

const page = readPageAddress(Astro.url.searchParams);
const loaded = await load(recordsList({ client: Astro.locals.api, query: page }));
const { items, next, prev } = loaded;
---

<CatalogueLayout
  title={m.recordsTitle()}
  description={m.recordsIntro()}
  canonicalPath="/records"
  noindex={page.offset > 0}
>
  <PageHeader title={m.recordsTitle()} />
  <RecordList
    records={items}
    prevHref={prev ? pageHref(Astro.url, prev) : null}
    nextHref={next ? pageHref(Astro.url, next) : null}
  />
</CatalogueLayout>
