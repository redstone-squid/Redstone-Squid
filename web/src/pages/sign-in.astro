---
import SignInPanel from "@/features/account/SignInPanel.svelte";
import { browserProvidersList } from "@/generated/sdk.gen";
import CatalogueLayout from "@/layouts/CatalogueLayout.astro";
import { localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import { load } from "@/server/api";
import { returnPath } from "@/server/session";
import PageHeader from "@/ui/patterns/PageHeader.svelte";

const { session, config } = Astro.locals;
const redirectTo = returnPath(Astro.url.searchParams.get("redirect_to"));
if (session?.user != null) return Astro.redirect(redirectTo);
const loaded = await load(browserProvidersList({ client: Astro.locals.api }));
// The API redirects to the relative `redirect_to` on its own origin, which is this site's
// (api-gaps.md item 52).
const providers = loaded.map((provider) => ({
  provider,
  href: `${config.apiBaseUrl}/v1/auth/${encodeURIComponent(provider.id)}?redirect_to=${encodeURIComponent(redirectTo)}`,
}));
const title = m.signInTitle();
---

<CatalogueLayout {title} canonicalPath="/sign-in" noindex>
  <PageHeader {title} description={m.signInDescription()} />
  <p>
    {m.signInAgreement()} <a href={localizePath("/terms")}>{m.termsTitle()}</a>.{" "}
    <a href={localizePath("/privacy")}>{m.privacyTitle()}</a>
  </p>
  <SignInPanel {providers} authError={Astro.url.searchParams.get("auth_error")} />
</CatalogueLayout>
