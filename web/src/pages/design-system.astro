---
import * as m from "@/locales/messages.gen";
import Layout from "@/ui/astro/Layout.astro";
import Panel from "@/ui/astro/Panel.astro";
import { parseTheme } from "@/ui/themes";
import BrowsingStories from "@/workbench/BrowsingStories.astro";
import ButtonStory from "@/workbench/ButtonStory.astro";
import SvelteControls from "@/workbench/Controls.svelte";
import Cover from "@/workbench/Cover.astro";
import FormSpecimen from "@/workbench/FormSpecimen.svelte";
import FoundationsStory from "@/workbench/FoundationsStory.astro";
import LayoutStory from "@/workbench/LayoutStory.astro";
import PatternsStory from "@/workbench/PatternsStory.astro";
import StatesStory from "@/workbench/StatesStory.astro";
import StoryOptions from "@/workbench/StoryOptions.astro";
import WorkbenchLayout from "@/workbench/WorkbenchLayout.astro";
import { selectedOption } from "@/workbench/story-option";

const theme = parseTheme(Astro.url.searchParams.get("theme"));
const fieldStates = {
  normal: m.workbenchNormal,
  invalid: m.workbenchInvalid,
  disabled: m.workbenchDisabled,
} as const;
const fieldState = selectedOption(fieldStates, Astro.url.searchParams, "fieldState", "normal");
---

<WorkbenchLayout title={m.workbenchPageTitle()} {theme}>
  <Cover {theme} />
  <FoundationsStory />
  <Panel
    id="components"
    title={m.workbenchComponents()}
    description={m.workbenchComponentsDescription()}
  >
    <ButtonStory {theme} />
    <SvelteControls client:load />
  </Panel>
  <Panel id="fields" title={m.workbenchFormControls()}>
    <Layout pattern="stack">
      <StoryOptions
        label={m.workbenchFieldState()}
        parameter="fieldState"
        selected={fieldState}
        section="fields"
        options={fieldStates}
      />
      <FormSpecimen state={fieldState} />
    </Layout>
  </Panel>
  <LayoutStory />
  <PatternsStory />
  <BrowsingStories />
  <StatesStory />
</WorkbenchLayout>
