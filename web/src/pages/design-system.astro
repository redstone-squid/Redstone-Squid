---
import { workbench } from "@/workbench/appearance";
import * as m from "@/locales/messages.gen";
import Card from "@/ui/data/Card.svelte";
import Text from "@/ui/content/Text.svelte";
import Layout from "@/ui/layout/Layout.svelte";
import Section from "@/ui/patterns/Section.svelte";
import Cover from "@/workbench/Cover.astro";
import Foundations from "@/workbench/Foundations.svelte";
import { GROUPS, groupNames } from "@/workbench/groups";
import WorkbenchLayout from "@/workbench/WorkbenchLayout.astro";

const preview = workbench.at(Astro);
---

<WorkbenchLayout title={m.workbenchPageTitle()}>
  <Cover />
  <Foundations />
  <Section title={m.workbenchComponents()} description={m.workbenchComponentsDescription()}>
    <Layout as="ul" pattern="grid" min="tile">
      {groupNames.map((slug) => (
        <Card as="li" title={GROUPS[slug].title()} href={preview.nav.link(workbench.group(slug))}>
          <Text size="sm" tone="muted">
            {GROUPS[slug].description()}
          </Text>
        </Card>
      ))}
    </Layout>
  </Section>
</WorkbenchLayout>
