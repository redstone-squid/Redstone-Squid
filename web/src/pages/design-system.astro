---
import * as m from "../locales/messages";
import BuildPreview from "../features/builds/BuildPreview.astro";
import "../workbench/workbench.css";
import WorkbenchLayout from "../workbench/WorkbenchLayout.astro";
import ButtonStory from "../workbench/ButtonStory.astro";
import Badge from "../ui/astro/Badge.astro";
import Layout from "../ui/astro/Layout.astro";
import Notice from "../ui/astro/Notice.astro";
import BrowsingStories from "../workbench/BrowsingStories.astro";
import FormSpecimen from "../workbench/FormSpecimen.svelte";
import StoryOptions from "../workbench/StoryOptions.astro";
import LayoutStory from "../workbench/LayoutStory.astro";
import Panel from "../ui/astro/Panel.astro";
import LinkButton from "../ui/astro/LinkButton.astro";
import SvelteControls from "../workbench/Controls.svelte";
import { buildFixtures } from "../workbench/fixtures";
import { selectedOption } from "../workbench/story-option";
const chinese = Astro.url.searchParams.get("lang") === "zh-CN";
const theme = Astro.url.searchParams.get("theme") === "dark" ? "dark" : "light";
const locale = chinese ? "zh-CN" : "en";
const fieldStates = {
  normal: m.workbenchNormal,
  invalid: m.workbenchInvalid,
  disabled: m.workbenchDisabled,
} as const;
const fieldState = selectedOption(fieldStates, Astro.url.searchParams, "fieldState", "normal");
const preferences = (key: string, value: string) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set(key, value);
  return `?${params}`;
};
---

<WorkbenchLayout title={m.workbenchPageTitle(locale)} locale={locale} theme={theme}>
  <header class="sq-library-cover">
    <div>
      <h1>{m.workbenchPageTitle(locale)}</h1>
      <p class="sq-lede">{m.workbenchLibraryDescription(locale)}</p>
      <div class="sq-row">
        <LinkButton href={preferences("lang", chinese ? "en" : "zh-CN")}>
          {m.workbenchSwitchLanguage(locale)}
        </LinkButton>
        <LinkButton href={preferences("theme", theme === "light" ? "dark" : "light")}>
          {theme === "light" ? m.workbenchDarkTheme(locale) : m.workbenchLightTheme(locale)}
        </LinkButton>
      </div>
    </div>
    <div aria-hidden="true" class="sq-cover-art">
      <img src="/fixtures/copper-door.svg" alt="" width="640" height="400" />
    </div>
  </header>
  <Panel
    id="foundations"
    title={m.workbenchFoundations(locale)}
    description={m.workbenchFoundationsDescription(locale)}
  >
    <div class="sq-swatches">
      {["canvas", "surface", "accent", "success", "warning", "text"].map((token) => (
        <div>
          <div class={`sq-swatch sq-swatch--${token}`}></div>
          <code>--{token}</code>
        </div>
      ))}
    </div>
    <div class="sq-token-footer">
      <h3>{m.workbenchSpacing(locale)}</h3>
      <div class="sq-ruler">
        {[1, 2, 3, 4, 5, 6, 7, 8].map((step) => (
          <div>
            <i style={`width:var(--space-${step})`}></i>
            <code>--space-{step}</code>
          </div>
        ))}
      </div>
    </div>
    <details class="sq-type-specimens">
      <summary>{m.workbenchTypography(locale)}</summary>
      <div>
        <div>
          <code>--font-sans</code>
          <p>{m.workbenchPistonDoor(locale)}</p>
        </div>
        <div>
          <code>--font-mono</code>
          <p>5 × 5 × 3</p>
        </div>
      </div>
    </details>
  </Panel>
  <Panel
    id="components"
    title={m.workbenchComponents(locale)}
    description={m.workbenchComponentsDescription(locale)}
  >
    <ButtonStory {locale} {theme} />
    <SvelteControls client:load locale={locale} />
  </Panel>
  <Panel id="fields" title={m.workbenchFormControls(locale)}>
    <Layout pattern="stack">
      <StoryOptions
        label={m.workbenchFieldState(locale)}
        parameter="fieldState"
        selected={fieldState}
        section="fields"
        {locale}
        options={fieldStates}
      />
      <FormSpecimen {locale} state={fieldState} />
    </Layout>
  </Panel>
  <LayoutStory {locale} />
  <section id="patterns" class="sq-stack" aria-labelledby="patterns-title">
    <div class="sq-section-heading">
      <div>
        <h2 id="patterns-title">{m.workbenchPagePatterns(locale)}</h2>
      </div>
      <span class="sq-muted">{m.workbenchBuildCount(locale, { count: buildFixtures.length })}</span>
    </div>
    <div class="sq-build-grid">
      {buildFixtures.map((build) => (
        <BuildPreview
          build={{
            ...build,
            category: build.category(locale),
            image: build.image
              ? {
                  src: build.image,
                  alt: m.workbenchFixtureAlt(locale, { title: build.title }),
                }
              : null,
          }}
          labels={{
            noPreview: m.workbenchNoPreviewAvailable(locale),
            dimensions: m.workbenchDimensions(locale),
            opening: m.workbenchOpening(locale),
          }}
        />
      ))}
    </div>
  </section>
  <BrowsingStories {locale} />
  <Panel
    id="states"
    title={m.workbenchFeedbackStates(locale)}
    description={m.workbenchStatesDescription(locale)}
  >
    <Layout pattern="grid">
      <Notice tone="success" title={m.workbenchReadyToExplore(locale)}>
        {m.workbenchApprovedDescription(locale)}
      </Notice>
      <Notice tone="info" title={m.workbenchNoMatchingBuilds(locale)}>
        {m.workbenchEmptyDescription(locale)}
      </Notice>
      <Notice tone="warning" title={m.workbenchCouldnTLoadBuilds(locale)}>
        {m.workbenchUnavailableDescription(locale)}
      </Notice>
      <Notice tone="danger" title={m.workbenchCheckTheHighlightedField(locale)}>
        {m.workbenchEnterATitleForYourBuild(locale)}
      </Notice>
    </Layout>
    <div class="sq-badge-preview">
      <h3>{m.workbenchStatusBadges(locale)}</h3>
      <Layout pattern="row" gap="compact">
        <Badge>{m.workbenchEmpty(locale)}</Badge>
        <Badge tone="success">{m.workbenchApproved(locale)}</Badge>
        <Badge tone="warning">{m.workbenchUnavailable(locale)}</Badge>
      </Layout>
    </div>
    <div class="sq-loading-preview">
      <p>{m.workbenchFetchingBuilds(locale)}</p>
      <div class="sq-skeleton"></div>
      <div class="sq-skeleton sq-skeleton--short"></div>
    </div>
  </Panel>
  <footer class="sq-workbench-footer">
    {m.workbenchRedstoneSquidDesignFoundations(locale)}
    <span>{m.workbenchFixtureDisclaimer(locale)}</span>
  </footer>
</WorkbenchLayout>
