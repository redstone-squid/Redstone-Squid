---
import { translate, type StaticMessageKey } from "../lib/i18n";
import BuildPreview from "../features/builds/BuildPreview.astro";
import "../workbench/workbench.css";
import WorkbenchLayout from "../workbench/WorkbenchLayout.astro";
import ButtonStory from "../workbench/ButtonStory.astro";
import Badge from "../ui/astro/Badge.astro";
import Layout from "../ui/astro/Layout.astro";
import Notice from "../ui/astro/Notice.astro";
import BrowsingStories from "../workbench/BrowsingStories.astro";
import FormSpecimen from "../workbench/FormSpecimen.svelte";
import StoryOptions from "../workbench/StoryOptions.astro";
import LayoutStory from "../workbench/LayoutStory.astro";
import Panel from "../ui/astro/Panel.astro";
import LinkButton from "../ui/astro/LinkButton.astro";
import SvelteControls from "../workbench/Controls.svelte";
import { buildFixtures } from "../workbench/fixtures";
const chinese = Astro.url.searchParams.get("lang") === "zh-CN";
const theme = Astro.url.searchParams.get("theme") === "dark" ? "dark" : "light";
const locale = chinese ? "zh-CN" : "en";
const fieldStates = ["normal", "invalid", "disabled"] as const;
const fieldState =
  fieldStates.find((value) => value === Astro.url.searchParams.get("fieldState")) ?? "normal";
const preferences = (key: string, value: string) => {
  const params = new URLSearchParams(Astro.url.searchParams);
  params.set(key, value);
  return `?${params}`;
};
const t = (key: StaticMessageKey): string => translate(locale, key);
---

<WorkbenchLayout title={t("workbench.page-title")} locale={locale} theme={theme}>
  <header class="sq-library-cover">
    <div>
      <h1>{t("workbench.page-title")}</h1>
      <p class="sq-lede">{t("workbench.library-description")}</p>
      <div class="sq-row">
        <LinkButton href={preferences("lang", chinese ? "en" : "zh-CN")}>
          {t("workbench.switch-language")}
        </LinkButton>
        <LinkButton href={preferences("theme", theme === "light" ? "dark" : "light")}>
          {theme === "light" ? t("workbench.dark-theme") : t("workbench.light-theme")}
        </LinkButton>
      </div>
    </div>
    <div aria-hidden="true" class="sq-cover-art">
      <img src="/fixtures/copper-door.svg" alt="" width="640" height="400" />
    </div>
  </header>
  <Panel
    id="foundations"
    title={t("workbench.foundations")}
    description={t("workbench.foundations-description")}
  >
    <div class="sq-swatches">
      {["canvas", "surface", "accent", "success", "warning", "text"].map((token) => (
        <div>
          <div class={`sq-swatch sq-swatch--${token}`}></div>
          <code>--{token}</code>
        </div>
      ))}
    </div>
    <div class="sq-token-footer">
      <h3>{t("workbench.spacing")}</h3>
      <div class="sq-ruler">
        {[1, 2, 3, 4, 5, 6, 7, 8].map((step) => (
          <div>
            <i style={`width:var(--space-${step})`}></i>
            <code>--space-{step}</code>
          </div>
        ))}
      </div>
    </div>
    <details class="sq-type-specimens">
      <summary>{t("workbench.typography")}</summary>
      <div>
        <div>
          <code>--font-sans</code>
          <p>{t("workbench.piston-door")}</p>
        </div>
        <div>
          <code>--font-mono</code>
          <p>5 × 5 × 3</p>
        </div>
      </div>
    </details>
  </Panel>
  <Panel
    id="components"
    title={t("workbench.components")}
    description={t("workbench.components-description")}
  >
    <ButtonStory {locale} {theme} />
    <SvelteControls client:load locale={locale} />
  </Panel>
  <Panel id="fields" title={t("workbench.form-controls")}>
    <Layout pattern="stack">
      <StoryOptions
        label={t("workbench.field-state")}
        parameter="fieldState"
        selected={fieldState}
        section="fields"
        options={fieldStates.map((value) => ({ value, label: t(`workbench.${value}`) }))}
      />
      <FormSpecimen {locale} state={fieldState} />
    </Layout>
  </Panel>
  <LayoutStory {locale} />
  <section id="patterns" class="sq-stack" aria-labelledby="patterns-title">
    <div class="sq-section-heading">
      <div>
        <h2 id="patterns-title">{t("workbench.page-patterns")}</h2>
      </div>
      <span class="sq-muted">
        {translate(locale, "workbench.build-count", { count: buildFixtures.length })}
      </span>
    </div>
    <div class="sq-build-grid">
      {buildFixtures.map((build) => (
        <BuildPreview
          build={{
            ...build,
            category: translate(locale, build.category),
            image: build.image
              ? {
                  src: build.image,
                  alt: translate(locale, "workbench.fixture-alt", { title: build.title }),
                }
              : null,
          }}
          labels={{
            noPreview: t("workbench.no-preview-available"),
            dimensions: t("workbench.dimensions"),
            opening: t("workbench.opening"),
          }}
        />
      ))}
    </div>
  </section>
  <BrowsingStories {locale} />
  <Panel
    id="states"
    title={t("workbench.feedback-states")}
    description={t("workbench.states-description")}
  >
    <Layout pattern="grid">
      <Notice tone="success" title={t("workbench.ready-to-explore")}>
        {t("workbench.confirmed-description")}
      </Notice>
      <Notice tone="info" title={t("workbench.no-matching-builds")}>
        {t("workbench.empty-description")}
      </Notice>
      <Notice tone="warning" title={t("workbench.couldn-t-load-builds")}>
        {t("workbench.unavailable-description")}
      </Notice>
      <Notice tone="danger" title={t("workbench.check-the-highlighted-field")}>
        {t("workbench.enter-a-title-for-your-build")}
      </Notice>
    </Layout>
    <div class="sq-badge-preview">
      <h3>{t("workbench.status-badges")}</h3>
      <Layout pattern="row" gap="compact">
        <Badge>{t("workbench.empty")}</Badge>
        <Badge tone="success">{t("workbench.confirmed")}</Badge>
        <Badge tone="warning">{t("workbench.unavailable")}</Badge>
      </Layout>
    </div>
    <div class="sq-loading-preview">
      <p>{t("workbench.fetching-builds")}</p>
      <div class="sq-skeleton"></div>
      <div class="sq-skeleton sq-skeleton--short"></div>
    </div>
  </Panel>
  <footer class="sq-workbench-footer">
    {t("workbench.redstone-squid-design-foundations")}
    <span>{t("workbench.fixture-disclaimer")}</span>
  </footer>
</WorkbenchLayout>
