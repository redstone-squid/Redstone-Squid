---
import WorkbenchLayout from "@/workbench/WorkbenchLayout.astro";
import * as m from "@/locales/messages.gen";
import LinkButton from "@/ui/astro/LinkButton.astro";
import PageHeading from "@/ui/astro/PageHeading.astro";
import { localizePath } from "@/locales/locale";
import { parseTheme } from "@/ui/themes";

const params = Astro.url.searchParams;
const theme = parseTheme(params.get("theme"));
const title = m.buildMedia();
---

<WorkbenchLayout {theme} {title}>
  <PageHeading {title} description={m.placeholderRebuilding()}>
    <LinkButton href={localizePath(`/design-system?${params}#browsing`)}>
      {m.workbenchBrowsing()}
    </LinkButton>
  </PageHeading>
</WorkbenchLayout>
