---
import { tagsGetBySlug } from "@/generated/sdk.gen";
import CatalogueLayout from "@/layouts/CatalogueLayout.astro";
import { localizePath } from "@/locales/locale";
import { load } from "@/server/api";
import PageHeader from "@/ui/patterns/PageHeader.svelte";

const slug = Astro.params.slug;
if (!slug) return Astro.rewrite("/404");
const loaded = await load(tagsGetBySlug({ client: Astro.locals.api, path: { slug } }));
if ("status" in loaded) return Astro.rewrite(`/${loaded.status}`);
const tag = loaded.data;
if (slug !== tag.slug) {
  return new Response(null, {
    status: 302,
    headers: {
      Location: localizePath(`/tags/${tag.slug}${Astro.url.search}`),
      "Cache-Control": "no-store",
    },
  });
}
---

<CatalogueLayout title={tag.name}>
  <PageHeader title={tag.name} />
</CatalogueLayout>
