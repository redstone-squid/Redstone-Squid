---
import WorkbenchLayout from "@/workbench/WorkbenchLayout.astro";
import LinkButton from "@/ui/astro/LinkButton.astro";
import PageHeading from "@/ui/astro/PageHeading.astro";
import Panel from "@/ui/astro/Panel.astro";
import * as m from "@/locales/messages.gen";
import SvelteDraftTrial from "@/workbench/DraftTrial.svelte";
import { parseTheme } from "@/ui/themes";
const theme = parseTheme(Astro.url.searchParams.get("theme"));
const selected = Astro.url.searchParams.get("scenario");
const scenario = selected === "retry" || selected === "upload-retry" ? selected : undefined;
const uploadScenario = new URLSearchParams({ theme, scenario: "upload-retry" });
---

<WorkbenchLayout title={m.trialTitle()} {theme}>
  <PageHeading title={m.trialTitle()}>
    <p>Svelte 5</p>
    <LinkButton
      href={`?${uploadScenario}`}
      size="small"
      aria-current={scenario === "upload-retry" ? "page" : undefined}
    >
      {m.trialUploadScenario()}
    </LinkButton>
  </PageHeading>
  <Panel id="trial" title={m.trialDetails()}>
    <SvelteDraftTrial client:load {scenario} />
  </Panel>
</WorkbenchLayout>
