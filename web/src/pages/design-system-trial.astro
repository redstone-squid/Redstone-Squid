---
import FlaskConical from "@lucide/svelte/icons/flask-conical";
import { workbench } from "@/workbench/appearance";
import * as m from "@/locales/messages.gen";
import Button from "@/ui/actions/Button.svelte";
import Notice from "@/ui/feedback/Notice.svelte";
import PageHeader from "@/ui/patterns/PageHeader.svelte";
import Section from "@/ui/patterns/Section.svelte";
import DraftTrial from "@/workbench/DraftTrial.svelte";
import WorkbenchLayout from "@/workbench/WorkbenchLayout.astro";

const params = Astro.url.searchParams;
const selected = params.get("scenario");
const scenario = selected === "retry" || selected === "upload-retry" ? selected : undefined;
const toggle = workbench.trialAt(Astro).update({
  scenario: scenario === "upload-retry" ? null : "upload-retry",
});
---

<WorkbenchLayout title={m.trialTitle()}>
  <PageHeader title={m.trialTitle()}>
    <Button
      slot="actions"
      size="sm"
      variant={scenario === "upload-retry" ? "primary" : "secondary"}
      href={toggle}
      aria-current={scenario === "upload-retry" ? "true" : undefined}
      icon={FlaskConical}
    >
      {m.trialUploadScenario()}
    </Button>
  </PageHeader>
  <noscript>
    <Notice>{m.workbenchNeedsJavascript()}</Notice>
  </noscript>
  <Section title={m.trialDetails()} surface>
    <DraftTrial client:load {scenario} />
  </Section>
</WorkbenchLayout>
