---
import BuildDetail from "@/features/catalogue/BuildDetail.svelte";
import { buildName } from "@/features/catalogue/presentation";
import { buildsGet } from "@/generated/sdk.gen";
import CatalogueLayout from "@/layouts/CatalogueLayout.astro";
import { load } from "@/server/api";
import { apiSessionCookie } from "@/server/cookies";
import { ApiError } from "@/api-client/api-error";

const id = Number(Astro.params.id);
if (!Number.isSafeInteger(id) || id < 1) throw new ApiError(404);
const cookie = apiSessionCookie(Astro);
const build = await load(
  buildsGet({
    client: Astro.locals.api,
    path: { build_id: id },
    headers: cookie ? { Cookie: cookie } : {},
  }),
);
---

<CatalogueLayout title={buildName(build)} canonicalPath={`/builds/${id}`}>
  <BuildDetail {build} />
</CatalogueLayout>
