---
import { accountGet, accountBuildIndexingSet, accountCreditClaims } from "@/generated/sdk.gen";
import CatalogueLayout from "@/layouts/CatalogueLayout.astro";
import { localizePath } from "@/locales/locale";
import * as m from "@/locales/messages.gen";
import { ApiError } from "@/api-client/api-error";
import { requireSession, writeHeaders } from "@/server/session";
import { load } from "@/server/api";
import CheckField from "@/ui/forms/CheckField.svelte";
import Button from "@/ui/actions/Button.svelte";
import Section from "@/ui/patterns/Section.svelte";
import PageHeader from "@/ui/patterns/PageHeader.svelte";
import Pagination from "@/ui/navigation/Pagination.svelte";
import { readPageAddress, pageHref } from "@/server/pagination";
const cookie = requireSession(Astro);
const client = Astro.locals.api;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const headers = writeHeaders(Astro);
  if (!headers) throw new ApiError(403);
  await load(
    accountBuildIndexingSet({
      client,
      headers,
      body: { enabled: form.get("indexing") === "on" },
    }),
  );
  return Astro.redirect(localizePath("/settings"), 303);
}
const [loaded, claims] = await Promise.all([
  load(accountGet({ client, headers: { Cookie: cookie } })),
  load(
    accountCreditClaims({
      client,
      query: readPageAddress(Astro.url.searchParams),
      headers: { Cookie: cookie },
    }),
  ),
]);
const title = m.indexingTitle();
---

<CatalogueLayout {title} noindex>
  <PageHeader {title} />
  <form method="post">
    <CheckField
      name="indexing"
      label={title}
      hint={m.indexingDescription()}
      checked={loaded.discord_build_indexing_enabled}
    />
    <Button type="submit">{m.indexingSave()}</Button>
  </form>
  <Section id="claims" title={m.creatorClaims()}>
    {claims.items.length === 0 ? (
      <p>{m.creatorClaimsEmpty()}</p>
    ) : (
      <ul>
        {claims.items.map((claim) => (
          <li>
            {claim.name} ·{" "}
            {claim.status === "approved"
              ? m.creatorClaimApproved()
              : claim.status === "rejected"
                ? m.creatorClaimRejected()
                : m.creatorClaimPending()}
          </li>
        ))}
      </ul>
    )}
    <Pagination
      prevHref={claims.prev ? pageHref(Astro.url, claims.prev) + "#claims" : null}
      nextHref={claims.next ? pageHref(Astro.url, claims.next) + "#claims" : null}
      labels={{ nav: m.navPagination(), previous: m.commonPrevious(), next: m.commonNext() }}
    />
  </Section>
</CatalogueLayout>
