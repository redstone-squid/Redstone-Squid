{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["src/generated/**", "**/*.gen.ts"],
  // Approved libraries installed before their first use, so agents reach for them instead of
  // writing their own. Remove an entry once code imports it. See "Libraries" in AGENTS.md.
  "ignoreDependencies": ["es-toolkit", "runed"],
}
