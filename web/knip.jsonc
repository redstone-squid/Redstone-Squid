{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The PWA build and Astro script src attributes are entry points knip cannot follow.
  "entry": [
    "src/sw.ts",
    "src/layouts/register-service-worker.ts",
    "src/layouts/browser-telemetry.ts",
    "src/ui/overlays/dropdown-position.ts",
    "src/layouts/appearance-switch.ts",
  ],
  "ignore": ["src/generated/**", "**/*.gen.ts"],
  // Approved libraries installed before their first use, so agents reach for them instead of
  // writing their own. Remove an entry once code imports it. See "Libraries" in AGENTS.md.
  "ignoreDependencies": ["@tanstack/svelte-query", "es-toolkit", "temporal-polyfill"],
}
