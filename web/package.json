{
  "name": "redstone-squid-catalogue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "bun run i18n:check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "start": "ASTRO_TELEMETRY_DISABLED=1 bun dist/server/entry.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "bun run i18n:check && ASTRO_TELEMETRY_DISABLED=1 astro check && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && bun run lint:css && knip",
    "lint:css": "stylelint \"src/**/*.{css,svelte,astro}\"",
    "sdk:generate": "openapi-ts -f openapi-ts.config.ts",
    "sdk:check": "bun run sdk:generate && git diff --exit-code -- src/generated",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:lighthouse": "bun scripts/check-lighthouse.ts",
    "check:bundle": "bun scripts/check-bundle.ts",
    "test:review": "playwright test --config playwright.review.config.ts",
    "test:compatibility": "playwright test --config playwright.compatibility.config.ts",
    "test:review:update": "bun run test:review --update-snapshots=all",
    "i18n:check": "bun scripts/i18n/build.ts",
    "i18n:generate": "bun scripts/i18n/build.ts --write",
    "i18n:review": "bun scripts/i18n/build.ts --review --write",
    "pwa:icons": "pwa-assets-generator --config pwa-assets.config.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@astrojs/svelte": "^9.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@lucide/svelte": "^1.73.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/svelte-query": "^6.4.5",
    "astro": "^7.4.12",
    "bits-ui": "^2.21.0",
    "class-variance-authority": "^0.7.1",
    "es-toolkit": "^1.53.2",
    "runed": "^0.38.0",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "temporal-polyfill": "^1.0.8",
    "zod": "^4.6.7"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@fluent/syntax": "^0.19.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.10",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/astro": "^2.0.4",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "lighthouse": "^13.6.0",
    "msw": "^3.0.7",
    "postcss-html": "^2.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^18.1.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
