{
  "name": "redstone-squid-catalogue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "start": "ASTRO_TELEMETRY_DISABLED=1 node dist/server/entry.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "sdk:generate": "openapi-ts -f openapi-ts.config.ts",
    "sdk:check": "bun run sdk:generate && git diff --exit-code -- src/generated",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:docs-screenshots": "DOCS_SCREENSHOTS=1 playwright test tests/e2e/docs-screenshots.spec.ts --project=chromium-desktop --project=mobile-chrome",
    "test:lighthouse": "bun scripts/check-lighthouse.ts",
    "check:bundle": "bun scripts/check-bundle.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@astrojs/react": "^7.1.9",
    "@hey-api/client-fetch": "^0.13.1",
    "astro": "^7.4.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
