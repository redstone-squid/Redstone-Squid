#!/bin/sh
#!/usr/bin/env bash

exit=0
echo "Running ruff check..."
if ! ruff check squid scripts tests --extend-select I --fix
then
    exit=1
fi

echo "Running ruff format..."
if ! ruff format squid scripts tests --check --quiet
then
    exit=1
    ruff format squid scripts tests
fi

if [ $exit -ne 0 ]
then
    echo "ruff checks or formatting failed."
    exit 1
fi

echo "ruff checks and formatting completed successfully."
