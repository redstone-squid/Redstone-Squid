"""Historical complete-family typing experiment; superseded by the parent plan."""

from collections.abc import Callable

from squid_ui.authoring.document import DocumentLike
from squid_ui.planning.composition import OccurrenceId
from squid_ui.selectors import Match, Query, Selector
from squid_ui.target_types import Renderable, RenderTarget

class RegionRef:
    @property
    def keys(self) -> tuple[str, ...]: ...

class ElementRef[NodeT]:
    @property
    def kind(self) -> type[NodeT]: ...

class PageCoordinate:
    @property
    def region(self) -> OccurrenceId: ...
    @property
    def index(self) -> int: ...
    @property
    def number(self) -> int: ...

class PageAddress:
    @property
    def coordinates(self) -> tuple[PageCoordinate, ...]: ...

class FragmentLocation:
    @property
    def occurrence(self) -> OccurrenceId: ...
    @property
    def page(self) -> PageAddress: ...
    @property
    def fragment(self) -> int: ...
    @property
    def repeated(self) -> bool: ...
    @property
    def visible(self) -> bool: ...

class RegionFacts:
    @property
    def identity(self) -> OccurrenceId: ...
    @property
    def count(self) -> int: ...
    @property
    def selection(self) -> PageCoordinate | None: ...

class DocumentScope:
    def query[NodeT](self, selector: Selector[NodeT]) -> Query[NodeT]: ...

class LayoutContext:
    @property
    def authored(self) -> DocumentScope: ...
    @property
    def placed(self) -> DocumentScope: ...
    @property
    def visible(self) -> DocumentScope: ...
    def region(self, reference: RegionRef | None = None) -> RegionFacts: ...
    def find_region(self, reference: RegionRef) -> RegionFacts | None: ...
    def locate[NodeT](
        self,
        target: ElementRef[NodeT] | Match[NodeT],
        *,
        within: RegionRef | None = None,
    ) -> tuple[FragmentLocation, ...]: ...

class Contextual[RenderTargetT = RenderTarget, ContextT = object](Renderable[RenderTargetT, ContextT]): ...

def region_ref(*keys: str) -> RegionRef: ...
def element_ref[NodeT](kind: type[NodeT], *keys: str) -> ElementRef[NodeT]: ...
def context[RenderTargetT, ContextT](
    callback: Callable[[LayoutContext], DocumentLike[RenderTargetT, ContextT]],
    *,
    key: str,
    initial: DocumentLike[RenderTargetT, ContextT] = (),
) -> Contextual[RenderTargetT, ContextT]: ...
